---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import NewArrivals from "../components/NewArrivals.astro";
import Offers from "../components/Offers.astro";
import Categories from "../components/Categories.astro";
import Suppliers from "../components/Suppliers.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import SEO from "../components/SEO.astro";
---

<html lang="es">
  <head>
    <SEO
      title="Costa Azul | Artesanías y Estilo de la Costa Salvadoreña"
      description="Descubre novedades, ofertas, categorías artesanales y creadores inspirados en Los Cóbanos y la costa salvadoreña en Costa Azul."
    />
  </head>

  <body>
    <Header />

    <main>
      <Hero />
      <NewArrivals />
      <Offers />
      <Categories />
      <Suppliers />
    </main>

    <Footer />
    <CartDrawer />
  </body>
</html>