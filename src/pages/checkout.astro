---
// src/pages/checkout.astro
import Footer from '../components/Footer.astro';

const pageTitle = "Checkout | Costa Azul";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="Finaliza tu compra en Costa Azul. Piezas artesanales inspiradas en la costa salvadoreña."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="checkout-header">
      <a href="/" class="brand" aria-label="Costa Azul Inicio">
        <svg class="brand-logo" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
          <circle cx="20" cy="14" r="6.5" fill="#E7DCC8" />
          <path d="M20 11V26M15.5 16H24.5M14 23C14 26.5 17 28.5 20 28.5C23 28.5 26 26.5 26 23" stroke="#002B5C" stroke-width="2.2" stroke-linecap="round" />
          <path d="M5 31C10 27.5 15 34.5 20 31C25 27.5 30 34.5 35 31" stroke="#002B5C" stroke-width="2.4" stroke-linecap="round" />
        </svg>
        <div class="brand-text">
          <span class="brand-name">COSTA AZUL</span>
          <span class="brand-sub">LOS CÓBANOS • EL SALVADOR</span>
        </div>
      </a>

      <div class="secure-checkout">
        <span>🔒</span>
        <span>Compra segura</span>
      </div>
    </header>

    <main class="checkout-page">
      <div class="checkout-container">

        <!-- CONTENIDO PRINCIPAL -->
        <section class="checkout-main">

          <div class="page-heading">
            <a href="/" class="back-link">← Seguir comprando</a>

            <h1>Finalizar compra</h1>
            <p>Completa tus datos para recibir tu pedido.</p>
          </div>

          <!-- CONTACTO -->
          <section class="checkout-section">
            <div class="section-title">
              <span class="section-number">1</span>

              <div>
                <h2>Información de contacto</h2>
                <p>¿Dónde podemos contactarte?</p>
              </div>
            </div>

            <div class="form-grid">

              <div class="form-group full">
                <label for="email">Correo electrónico</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="tu@email.com"
                  autocomplete="email"
                  required
                />
              </div>

              <div class="form-group">
                <label for="firstName">Nombre</label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  placeholder="Tu nombre"
                  autocomplete="given-name"
                  required
                />
              </div>

              <div class="form-group">
                <label for="lastName">Apellido</label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  placeholder="Tu apellido"
                  autocomplete="family-name"
                  required
                />
              </div>

              <div class="form-group full">
                <label for="phone">Teléfono / WhatsApp</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="+503 0000-0000"
                  autocomplete="tel"
                  required
                />
              </div>

            </div>
          </section>

          <!-- ENVÍO -->
          <section class="checkout-section">
            <div class="section-title">
              <span class="section-number">2</span>

              <div>
                <h2>Dirección de envío</h2>
                <p>¿Dónde entregaremos tu pedido?</p>
              </div>
            </div>

            <div class="form-grid">

              <div class="form-group full">
                <label for="country">País</label>

                <select id="country" name="country" required>
                  <option value="">Selecciona un país</option>
                  <option value="SV">El Salvador</option>
                  <option value="GT">Guatemala</option>
                  <option value="HN">Honduras</option>
                  <option value="NI">Nicaragua</option>
                  <option value="CR">Costa Rica</option>
                  <option value="PA">Panamá</option>
                  <option value="MX">México</option>
                  <option value="US">Estados Unidos</option>
                </select>
              </div>

              <div class="form-group">
                <label for="city">Ciudad</label>
                <input
                  type="text"
                  id="city"
                  name="city"
                  placeholder="Ciudad"
                  autocomplete="address-level2"
                  required
                />
              </div>

              <div class="form-group">
                <label for="department">Departamento / Estado</label>
                <input
                  type="text"
                  id="department"
                  name="department"
                  placeholder="Departamento"
                  autocomplete="address-level1"
                  required
                />
              </div>

              <div class="form-group full">
                <label for="address">Dirección</label>

                <textarea
                  id="address"
                  name="address"
                  rows="3"
                  placeholder="Calle, avenida, número de casa, colonia, etc."
                  autocomplete="street-address"
                  required
                ></textarea>
              </div>

              <div class="form-group">
                <label for="postalCode">Código postal</label>

                <input
                  type="text"
                  id="postalCode"
                  name="postalCode"
                  placeholder="Código postal"
                  autocomplete="postal-code"
                />
              </div>

              <div class="form-group">
                <label for="reference">Referencia</label>

                <input
                  type="text"
                  id="reference"
                  name="reference"
                  placeholder="Punto de referencia"
                />
              </div>

            </div>
          </section>

          <!-- MÉTODO DE PAGO -->
          <section class="checkout-section">
            <div class="section-title">
              <span class="section-number">3</span>

              <div>
                <h2>Método de pago</h2>
                <p>Elige cómo deseas realizar tu pago.</p>
              </div>
            </div>

            <div class="payment-options" id="payment-options">

              <label class="payment-option selected" data-payment-option="transfer">
                <input
                  type="radio"
                  name="payment"
                  value="transfer"
                  checked
                />

                <div class="payment-icon">🏦</div>

                <div class="payment-info">
                  <strong>Transferencia bancaria</strong>
                  <span>Realiza tu depósito o transferencia y envíanos tu comprobante</span>
                </div>

                <span class="payment-check">✓</span>
              </label>

              <label class="payment-option" data-payment-option="cod">
                <input
                  type="radio"
                  name="payment"
                  value="cod"
                />

                <div class="payment-icon">💵</div>

                <div class="payment-info">
                  <strong>Pago contra entrega</strong>
                  <span>Paga en efectivo o al recibir tu pedido</span>
                </div>

                <span class="payment-check">✓</span>
              </label>

              <label class="payment-option" data-payment-option="payment_link">
                <input
                  type="radio"
                  name="payment"
                  value="payment_link"
                />

                <div class="payment-icon">🔗</div>

                <div class="payment-info">
                  <strong>Link de pago</strong>
                  <span>Te compartiremos un enlace directo para pagar en línea</span>
                </div>

                <span class="payment-check">✓</span>
              </label>

            </div>

            <div id="payment-details" class="payment-details">
              <p id="payment-helper-text">
                Realiza la transferencia a la siguiente cuenta y envía tu comprobante por WhatsApp indicando tu número de pedido:
              </p>

              <div id="bank-info-box" class="bank-info-box">
                <div class="bank-info-header">
                  <strong>Datos bancarios Costa Azul</strong>
                  <button type="button" class="copy-bank-btn" data-copy-bank>
                    Copiar datos
                  </button>
                </div>
                <ul class="bank-info-list">
                  <li><span>Banco:</span> <strong data-bank-field="bankName">Banco Agrícola</strong></li>
                  <li><span>Tipo de cuenta:</span> <strong data-bank-field="accountType">Cuenta de Ahorro</strong></li>
                  <li><span>Número de cuenta:</span> <strong data-bank-field="accountNumber">0000-0000-0000-0</strong></li>
                  <li><span>Titular:</span> <strong data-bank-field="accountHolder">Costa Azul El Salvador</strong></li>
                </ul>
              </div>
            </div>
          </section>

          <!-- NOTAS -->
          <section class="checkout-section">
            <div class="section-title">
              <span class="section-number">4</span>

              <div>
                <h2>Notas del pedido</h2>
                <p>Opcional</p>
              </div>
            </div>

            <div class="form-group">
              <textarea
                id="orderNotes"
                name="orderNotes"
                rows="4"
                placeholder="¿Hay alguna indicación especial para tu pedido?"
              ></textarea>
            </div>
          </section>

        </section>

        <!-- RESUMEN -->
        <aside class="checkout-summary">

          <div class="summary-card">

            <div class="summary-header">
              <h2>Tu pedido</h2>
              <span id="summary-count">0 productos</span>
            </div>

            <div id="summary-items" class="summary-items">
              <!-- Productos generados por JavaScript -->
            </div>

            <div id="empty-checkout" class="empty-checkout">
              <div>🛍️</div>
              <p>No tienes productos en tu carrito.</p>
              <a href="/">Volver a la tienda</a>
            </div>

            <div class="summary-totals">

              <div class="summary-row">
                <span>Subtotal</span>
                <strong id="subtotal">$0.00</strong>
              </div>

              <div class="summary-row">
                <span>Envío</span>
                <strong id="shipping">$0.00</strong>
              </div>

              <div class="summary-row total-row">
                <span>Total</span>
                <strong id="total">$0.00</strong>
              </div>

            </div>

            <button
              type="button"
              id="place-order"
              class="place-order"
            >
              Confirmar pedido
            </button>

            <p class="terms">
              Al confirmar tu pedido aceptas nuestros
              <a href="#">términos y condiciones</a>.
            </p>

          </div>

        </aside>

      </div>
    </main>

    <!-- CONFIRMACIÓN -->
    <div id="success-modal" class="success-modal">
      <div class="success-card">

        <div class="success-icon">✓</div>

        <h2>¡Pedido recibido!</h2>

        <p id="success-description">
          Gracias por comprar en Costa Azul.
          Hemos recibido la información de tu pedido.
        </p>

        <div class="order-number">
          Pedido <strong id="order-number">CA-000000</strong>
        </div>

        <div id="modal-bank-box" class="bank-info-box modal-bank-box">
          <div class="bank-info-header">
            <strong>Datos para transferencia</strong>
            <button type="button" class="copy-bank-btn" data-copy-bank>
              Copiar datos
            </button>
          </div>
          <ul class="bank-info-list">
            <li><span>Banco:</span> <strong data-bank-field="bankName">Banco Agrícola</strong></li>
            <li><span>Tipo de cuenta:</span> <strong data-bank-field="accountType">Cuenta de Ahorro</strong></li>
            <li><span>Número de cuenta:</span> <strong data-bank-field="accountNumber">0000-0000-0000-0</strong></li>
            <li><span>Titular:</span> <strong data-bank-field="accountHolder">Costa Azul El Salvador</strong></li>
          </ul>
        </div>

        <div class="success-actions">
          <a
            id="whatsapp-store-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="whatsapp-button"
          >
            Enviar comprobante por WhatsApp
          </a>

          <a href="/" class="success-button">
            Volver a Costa Azul
          </a>
        </div>

      </div>
    </div>

    <Footer />

    <script is:inline define:vars={{ BACKEND_URL: import.meta.env.PUBLIC_API_URL || 'https://superior-star.onrender.com' }}>
      const CART_KEY = "tekiti-cart";

      // Reemplaza por el número oficial de WhatsApp de Costa Azul (código de país + número, sin '+' ni espacios)
      const STORE_WHATSAPP_PHONE = "50370854119";

      // Reemplaza estos valores por los datos bancarios reales de Costa Azul
      const BANK_INFO = {
        bankName: "Banco Agrícola",
        accountType: "Cuenta de Ahorro",
        accountNumber: "0000-0000-0000-0",
        accountHolder: "Costa Azul El Salvador",
      };

      const summaryItems = document.querySelector("#summary-items");
      const emptyCheckout = document.querySelector("#empty-checkout");
      const summaryCount = document.querySelector("#summary-count");
      const subtotalElement = document.querySelector("#subtotal");
      const shippingElement = document.querySelector("#shipping");
      const totalElement = document.querySelector("#total");
      const placeOrderButton = document.querySelector("#place-order");
      const successModal = document.querySelector("#success-modal");
      const successDescription = document.querySelector("#success-description");
      const orderNumber = document.querySelector("#order-number");
      const modalBankBox = document.querySelector("#modal-bank-box");
      const whatsappStoreLink = document.querySelector("#whatsapp-store-link");

      const paymentOptionLabels = document.querySelectorAll(".payment-option");
      const paymentHelperText = document.querySelector("#payment-helper-text");
      const bankInfoBox = document.querySelector("#bank-info-box");
      const copyBankButtons = document.querySelectorAll("[data-copy-bank]");

      const PAYMENT_MESSAGES = {
        transfer:
          "Realiza la transferencia a la siguiente cuenta y envía tu comprobante por WhatsApp indicando tu número de pedido:",
        cod:
          "Al confirmar tu pedido coordinaremos la entrega a tu dirección y realizarás el pago al momento de recibirlo.",
        payment_link:
          "Al confirmar tu pedido te enviaremos tu link de pago por WhatsApp o correo electrónico para completar la transacción.",
      };

      const SUCCESS_MESSAGES = {
        transfer:
          "Gracias por comprar en Costa Azul. Realiza tu transferencia con los siguientes datos y envíanos el comprobante por WhatsApp.",
        cod:
          "Gracias por comprar en Costa Azul. Coordinaremos tu envío y el pago contra entrega.",
        payment_link:
          "Gracias por comprar en Costa Azul. Pronto te compartiremos tu link de pago.",
      };

      const PAYMENT_API_VALUES = {
        transfer: "BANK_TRANSFER",
        cod: "CASH_ON_DELIVERY",
        payment_link: "PAYMENT_LINK",
      };

      function populateBankFields() {
        document.querySelectorAll("[data-bank-field]").forEach((el) => {
          const key = el.getAttribute("data-bank-field");
          if (key && BANK_INFO[key]) {
            el.textContent = BANK_INFO[key];
          }
        });
      }

      function getBankDetailsPlainText() {
        return [
          "Datos bancarios Costa Azul:",
          `Banco: ${BANK_INFO.bankName}`,
          `Tipo de cuenta: ${BANK_INFO.accountType}`,
          `Número de cuenta: ${BANK_INFO.accountNumber}`,
          `Titular: ${BANK_INFO.accountHolder}`,
        ].join("\n");
      }

      copyBankButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const textToCopy = getBankDetailsPlainText();
          try {
            await navigator.clipboard.writeText(textToCopy);
          } catch {
            const temp = document.createElement("textarea");
            temp.value = textToCopy;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand("copy");
            document.body.removeChild(temp);
          }

          const originalLabel = button.textContent;
          button.textContent = "¡Copiado!";
          button.classList.add("copied");
          setTimeout(() => {
            button.textContent = originalLabel;
            button.classList.remove("copied");
          }, 2000);
        });
      });

      function buildStoreWhatsAppUrl({ paymentKey, customerName, customerPhone, orderCode, totalText }) {
        const cleanStorePhone = (STORE_WHATSAPP_PHONE || "").replace(/\D+/g, "");
        if (!cleanStorePhone) return "#";

        let messageLines;

        if (paymentKey === "transfer") {
          messageLines = [
            `¡Hola Costa Azul! Acabo de realizar el pedido *${orderCode}*.`,
            `• Nombre: ${customerName}`,
            `• Teléfono: ${customerPhone}`,
            `• Total: ${totalText}`,
            "",
            "Adjunto mi comprobante de transferencia bancaria.",
          ];
        } else if (paymentKey === "payment_link") {
          messageLines = [
            `¡Hola Costa Azul! Acabo de realizar el pedido *${orderCode}* por ${totalText}.`,
            `¿Me pueden compartir el link de pago? Mi nombre es ${customerName}.`,
          ];
        } else {
          messageLines = [
            `¡Hola Costa Azul! Acabo de confirmar mi pedido *${orderCode}* (Pago contra entrega) por ${totalText}.`,
            `Mi nombre es ${customerName}.`,
          ];
        }

        return `https://wa.me/${cleanStorePhone}?text=${encodeURIComponent(messageLines.join("\n"))}`;
      }

      function updatePaymentUI(value) {
        paymentOptionLabels.forEach((label) => {
          const isMatch = label.getAttribute("data-payment-option") === value;
          label.classList.toggle("selected", isMatch);
        });

        if (paymentHelperText && PAYMENT_MESSAGES[value]) {
          paymentHelperText.textContent = PAYMENT_MESSAGES[value];
        }

        if (bankInfoBox) {
          bankInfoBox.style.display = value === "transfer" ? "block" : "none";
        }
      }

      paymentOptionLabels.forEach((label) => {
        const radio = label.querySelector('input[type="radio"]');
        radio?.addEventListener("change", () => {
          updatePaymentUI(radio.value);
        });
      });

      function getCart() {
        try {
          return JSON.parse(localStorage.getItem(CART_KEY) || "[]");
        } catch {
          return [];
        }
      }

      function formatPrice(value) {
        return new Intl.NumberFormat("en-US", {
          style: "currency",
          currency: "USD",
        }).format(value);
      }

      function renderCheckout() {
        const cart = getCart();
        summaryItems.innerHTML = "";

        const totalProducts = cart.reduce(
          (total, item) => total + item.quantity,
          0
        );

        summaryCount.textContent = `${totalProducts} ${totalProducts === 1 ? "producto" : "productos"}`;

        if (cart.length === 0) {
          summaryItems.style.display = "none";
          emptyCheckout.style.display = "flex";
          subtotalElement.textContent = "$0.00";
          shippingElement.textContent = "$0.00";
          totalElement.textContent = "$0.00";
          placeOrderButton.disabled = true;
          return;
        }

        summaryItems.style.display = "flex";
        emptyCheckout.style.display = "none";
        placeOrderButton.disabled = false;

        let subtotal = 0;

        cart.forEach((item) => {
          subtotal += item.price * item.quantity;
          const itemElement = document.createElement("div");
          itemElement.className = "summary-item";

          itemElement.innerHTML = `
            <div class="summary-item-quantity">
              ${item.quantity}
            </div>
            <div class="summary-item-info">
              <strong>${item.name}</strong>
              <span>
                ${item.quantity} × ${formatPrice(item.price)}
              </span>
            </div>
            <strong class="summary-item-price">
              ${formatPrice(item.price * item.quantity)}
            </strong>
          `;

          summaryItems.appendChild(itemElement);
        });

        const shipping = subtotal >= 100 ? 0 : 7.5;
        const total = subtotal + shipping;

        subtotalElement.textContent = formatPrice(subtotal);
        shippingElement.textContent = shipping === 0 ? "Gratis" : formatPrice(shipping);
        totalElement.textContent = formatPrice(total);
      }

      placeOrderButton.addEventListener("click", async () => {
        const cart = getCart();
        if (cart.length === 0) return;

        const requiredFields = document.querySelectorAll(
          "input[required], select[required], textarea[required]"
        );

        let valid = true;
        requiredFields.forEach((field) => {
          if (!field.value.trim()) {
            field.classList.add("error");
            valid = false;
          } else {
            field.classList.remove("error");
          }
        });

        if (!valid) {
          const firstError = document.querySelector(".error");
          firstError?.focus();
          return;
        }

        const email = document.querySelector("#email").value.trim();
        const firstName = document.querySelector("#firstName").value.trim();
        const lastName = document.querySelector("#lastName").value.trim();
        const phone = document.querySelector("#phone").value.trim();
        const fullName = `${firstName} ${lastName}`.trim();

        const countrySelect = document.querySelector("#country");
        const country = countrySelect.options[countrySelect.selectedIndex]?.text || "";
        const city = document.querySelector("#city").value.trim();
        const department = document.querySelector("#department").value.trim();
        const address = document.querySelector("#address").value.trim();
        const reference = document.querySelector("#reference").value.trim();

        const selectedPayment = document.querySelector('input[name="payment"]:checked');
        const paymentKey = selectedPayment?.value || "transfer";
        const paymentMethod = PAYMENT_API_VALUES[paymentKey] || "BANK_TRANSFER";
        const orderNotes = document.querySelector("#orderNotes").value.trim();

        const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
        const shipping = subtotal >= 100 ? 0 : 7.5;
        const totalText = formatPrice(subtotal + shipping);

        placeOrderButton.disabled = true;
        placeOrderButton.textContent = "Procesando pedido...";

        try {
          const response = await fetch(`${BACKEND_URL}/api/orders`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              customer: {
                name: fullName,
                email,
                phone,
              },
              shipping: {
                name: fullName,
                address: reference ? `${address}. Referencia: ${reference}` : address,
                city,
                country,
                phone,
              },
              items: cart.map((item) => ({
                productId: Number(item.id),
                quantity: item.quantity,
              })),
              paymentMethod,
              notes: orderNotes || null,
            }),
          });

          const result = await response.json();

          if (!response.ok || !result.success) {
            throw new Error(result.message || "No se pudo crear el pedido");
          }

          const createdOrderNumber = result.data?.orderNumber || "CA-000000";
          orderNumber.textContent = createdOrderNumber;

          if (successDescription && SUCCESS_MESSAGES[paymentKey]) {
            successDescription.textContent = SUCCESS_MESSAGES[paymentKey];
          }

          if (modalBankBox) {
            modalBankBox.style.display = paymentKey === "transfer" ? "block" : "none";
          }

          if (whatsappStoreLink) {
            whatsappStoreLink.href = buildStoreWhatsAppUrl({
              paymentKey,
              customerName: fullName,
              customerPhone: phone,
              orderCode: createdOrderNumber,
              totalText,
            });
            whatsappStoreLink.textContent =
              paymentKey === "transfer"
                ? "Enviar comprobante por WhatsApp"
                : paymentKey === "payment_link"
                  ? "Solicitar link de pago por WhatsApp"
                  : "Confirmar pedido por WhatsApp";
          }

          successModal.classList.add("visible");

          localStorage.removeItem(CART_KEY);
          renderCheckout();

          window.dispatchEvent(new CustomEvent("tekiti-cart-updated"));
          window.dispatchEvent(
            new StorageEvent("storage", {
              key: CART_KEY,
              newValue: null,
            })
          );
        } catch (error) {
          console.error("Error al crear el pedido:", error);
          alert(error instanceof Error ? error.message : "No se pudo procesar el pedido.");
          placeOrderButton.disabled = false;
          placeOrderButton.textContent = "Confirmar pedido";
        }
      });

      window.addEventListener("storage", (event) => {
        if (event.key === CART_KEY) {
          renderCheckout();
        }
      });

      populateBankFields();
      const initialSelected = document.querySelector('input[name="payment"]:checked')?.value || "transfer";
      updatePaymentUI(initialSelected);
      renderCheckout();
    </script>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background: #FAF8F5;
        color: #1E293B;
        font-family: 'Plus Jakarta Sans', sans-serif;
      }

      :global(button),
      :global(input),
      :global(select),
      :global(textarea) {
        font: inherit;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      .checkout-header {
        height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 5%;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #E7DCC8;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .brand-text {
        display: flex;
        flex-direction: column;
      }

      .brand-name {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        color: #002B5C;
        line-height: 1.1;
      }

      .brand-sub {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: #64748B;
      }

      .secure-checkout {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        border-radius: 999px;
        background: #E7DCC8;
        color: #002B5C;
        font-size: 0.8rem;
        font-weight: 700;
      }

      .checkout-page {
        padding: 48px 5% 80px;
      }

      .checkout-container {
        width: min(1180px, 100%);
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(320px, 0.9fr);
        gap: 42px;
        align-items: start;
      }

      .page-heading {
        margin-bottom: 32px;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 16px;
        color: #002B5C;
        font-size: 0.84rem;
        font-weight: 700;
      }

      .back-link:hover {
        text-decoration: underline;
      }

      .page-heading h1 {
        margin: 0 0 8px;
        font-family: 'Montserrat', sans-serif;
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 800;
        color: #002B5C;
      }

      .page-heading p {
        margin: 0;
        color: #64748B;
        font-size: 0.94rem;
      }

      .checkout-section {
        margin-bottom: 24px;
        padding: 30px;
        background: #FFFFFF;
        border: 1px solid #E7DCC8;
        border-radius: 20px;
        box-shadow: 0 6px 20px rgba(0, 43, 92, 0.04);
      }

      .section-title {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 24px;
      }

      .section-number {
        width: 30px;
        height: 30px;
        flex: 0 0 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #002B5C;
        color: #E7DCC8;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.78rem;
        font-weight: 800;
      }

      .section-title h2 {
        margin: 0 0 4px;
        font-family: 'Montserrat', sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: #002B5C;
      }

      .section-title p {
        margin: 0;
        color: #64748B;
        font-size: 0.82rem;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
      }

      .form-group.full {
        grid-column: 1 / -1;
      }

      .form-group label {
        color: #002B5C;
        font-size: 0.8rem;
        font-weight: 700;
      }

      .form-group input,
      .form-group select,
      .form-group textarea {
        width: 100%;
        padding: 13px 14px;
        border: 1px solid #E7DCC8;
        border-radius: 12px;
        outline: none;
        background: #FAF8F5;
        color: #1E293B;
        font-size: 0.88rem;
        transition: border-color 0.2s ease, background 0.2s ease;
      }

      .form-group textarea {
        resize: vertical;
        min-height: 100px;
      }

      .form-group input:focus,
      .form-group select:focus,
      .form-group textarea:focus {
        border-color: #002B5C;
        background: #FFFFFF;
      }

      .form-group input.error,
      .form-group select.error,
      .form-group textarea.error {
        border-color: #C74747;
      }

      .payment-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .payment-option {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px;
        border: 1.5px solid #E7DCC8;
        border-radius: 14px;
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease;
      }

      .payment-option.selected {
        border-color: #002B5C;
        background: #FAF8F5;
      }

      .payment-option input {
        position: absolute;
        opacity: 0;
      }

      .payment-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #E7DCC8;
        border-radius: 50%;
        font-size: 1rem;
      }

      .payment-info {
        display: flex;
        flex-direction: column;
        gap: 3px;
      }

      .payment-info strong {
        font-size: 0.88rem;
        color: #002B5C;
      }

      .payment-info span {
        color: #64748B;
        font-size: 0.78rem;
      }

      .payment-check {
        margin-left: auto;
        color: #002B5C;
        opacity: 0;
        font-weight: 800;
      }

      .payment-option.selected .payment-check {
        opacity: 1;
      }

      .payment-details {
        margin-top: 18px;
        padding: 16px 18px;
        background: #FAF8F5;
        border: 1px solid #E7DCC8;
        border-radius: 14px;
        color: #475569;
        font-size: 0.82rem;
        line-height: 1.55;
      }

      .payment-details p {
        margin: 0;
      }

      .bank-info-box {
        margin-top: 14px;
        padding: 14px 16px;
        background: #FFFFFF;
        border: 1px solid #E7DCC8;
        border-radius: 12px;
        text-align: left;
      }

      .modal-bank-box {
        margin-top: 0;
        margin-bottom: 20px;
        background: #FAF8F5;
      }

      .bank-info-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
        padding-bottom: 8px;
        border-bottom: 1px solid #E7DCC8;
      }

      .bank-info-header strong {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.8rem;
        color: #002B5C;
      }

      .copy-bank-btn {
        padding: 5px 12px;
        border: 1px solid #002B5C;
        border-radius: 999px;
        background: #FFFFFF;
        color: #002B5C;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
      }

      .copy-bank-btn:hover,
      .copy-bank-btn.copied {
        background: #002B5C;
        color: #FFFFFF;
      }

      .bank-info-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 0.8rem;
      }

      .bank-info-list li {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        color: #64748B;
      }

      .bank-info-list li strong {
        color: #002B5C;
        font-weight: 700;
        text-align: right;
      }

      /* RESUMEN */

      .checkout-summary {
        position: sticky;
        top: 28px;
      }

      .summary-card {
        padding: 28px;
        background: #FFFFFF;
        border: 1px solid #E7DCC8;
        border-radius: 20px;
        box-shadow: 0 6px 20px rgba(0, 43, 92, 0.04);
      }

      .summary-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 18px;
        border-bottom: 1px solid #E7DCC8;
      }

      .summary-header h2 {
        margin: 0;
        font-family: 'Montserrat', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        color: #002B5C;
      }

      .summary-header span {
        color: #64748B;
        font-size: 0.78rem;
        font-weight: 600;
      }

      .summary-items {
        display: flex;
        flex-direction: column;
      }

      .summary-item {
        display: grid;
        grid-template-columns: 28px 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 16px 0;
        border-bottom: 1px solid #E7DCC8;
      }

      .summary-item-quantity {
        width: 26px;
        height: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: #E7DCC8;
        color: #002B5C;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 800;
      }

      .summary-item-info {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
      }

      .summary-item-info strong {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.84rem;
        color: #002B5C;
      }

      .summary-item-info span {
        color: #64748B;
        font-size: 0.74rem;
      }

      .summary-item-price {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.84rem;
        color: #002B5C;
        white-space: nowrap;
      }

      .empty-checkout {
        min-height: 220px;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #64748B;
      }

      .empty-checkout div {
        margin-bottom: 12px;
        font-size: 2rem;
      }

      .empty-checkout p {
        margin: 0 0 14px;
        font-size: 0.86rem;
      }

      .empty-checkout a {
        color: #002B5C;
        font-size: 0.84rem;
        font-weight: 700;
        text-decoration: underline;
      }

      .summary-totals {
        padding: 20px 0;
      }

      .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 12px;
        color: #64748B;
        font-size: 0.86rem;
      }

      .summary-row strong {
        color: #1E293B;
      }

      .total-row {
        margin: 18px 0 0;
        padding-top: 18px;
        border-top: 1px solid #E7DCC8;
        color: #002B5C;
        font-size: 1rem;
        font-weight: 700;
      }

      .total-row strong {
        color: #002B5C;
        font-family: 'Montserrat', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
      }

      .place-order {
        width: 100%;
        padding: 15px 22px;
        border: 0;
        border-radius: 999px;
        background: #002B5C;
        color: #FFFFFF;
        cursor: pointer;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.88rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .place-order:hover:not(:disabled) {
        background: #001d40;
        transform: translateY(-1px);
      }

      .place-order:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }

      .terms {
        margin: 16px 0 0;
        color: #64748B;
        font-size: 0.72rem;
        line-height: 1.5;
        text-align: center;
      }

      .terms a {
        color: #002B5C;
        text-decoration: underline;
      }

      /* MODAL */

      .success-modal {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(0, 43, 92, 0.6);
      }

      .success-modal.visible {
        display: flex;
      }

      .success-card {
        width: min(470px, 100%);
        max-height: 92vh;
        overflow-y: auto;
        padding: 36px 28px;
        background: #FFFFFF;
        border: 1px solid #E7DCC8;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 16px 40px rgba(0, 43, 92, 0.18);
      }

      .success-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #002B5C;
        color: #E7DCC8;
        font-size: 1.65rem;
        font-weight: 800;
      }

      .success-card h2 {
        margin: 0 0 10px;
        font-family: 'Montserrat', sans-serif;
        font-size: 1.65rem;
        font-weight: 800;
        color: #002B5C;
      }

      .success-card p {
        margin: 0 auto 18px;
        max-width: 350px;
        color: #475569;
        font-size: 0.88rem;
        line-height: 1.6;
      }

      .order-number {
        margin-bottom: 18px;
        padding: 12px 16px;
        border-radius: 12px;
        background: #FAF8F5;
        border: 1px solid #E7DCC8;
        color: #64748B;
        font-size: 0.84rem;
      }

      .order-number strong {
        color: #002B5C;
        font-family: 'Montserrat', sans-serif;
      }

      .success-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: center;
      }

      .whatsapp-button {
        display: inline-flex;
        width: 100%;
        justify-content: center;
        align-items: center;
        padding: 13px 22px;
        border-radius: 999px;
        background: #15803D;
        color: #FFFFFF;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.84rem;
        font-weight: 700;
      }

      .whatsapp-button:hover {
        background: #166534;
      }

      .success-button {
        display: inline-block;
        width: 100%;
        padding: 12px 24px;
        border-radius: 999px;
        background: #002B5C;
        color: #FFFFFF;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.84rem;
        font-weight: 700;
      }

      .success-button:hover {
        background: #001d40;
      }

      @media (max-width: 900px) {
        .checkout-container {
          grid-template-columns: 1fr;
        }

        .checkout-summary {
          position: static;
          order: -1;
        }
      }

      @media (max-width: 600px) {
        .checkout-header {
          height: 68px;
          padding: 0 20px;
        }

        .brand-name {
          font-size: 1.05rem;
        }

        .secure-checkout span:last-child {
          display: none;
        }

        .checkout-page {
          padding: 30px 15px 50px;
        }

        .checkout-section {
          padding: 22px 18px;
        }

        .form-grid {
          grid-template-columns: 1fr;
        }

        .form-group.full {
          grid-column: auto;
        }

        .summary-card {
          padding: 22px 18px;
        }

        .page-heading h1 {
          font-size: 1.9rem;
        }
      }
    </style>
  </body>
</html>