---
const pageTitle = "Checkout | TEKITI";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="Finaliza tu compra en TEKITI."
    />
  </head>

  <body>
    <header class="checkout-header">
      <a href="/" class="brand">TEKITI</a>

      <div class="secure-checkout">
        <span>🔒</span>
        <span>Compra segura</span>
      </div>
    </header>

    <main class="checkout-page">
      <div class="checkout-container">

        <!-- CONTENIDO PRINCIPAL -->
        <section class="checkout-main">

          <div class="page-heading">
            <a href="/" class="back-link">← Seguir comprando</a>

            <h1>Finalizar compra</h1>
            <p>Completa tus datos para recibir tu pedido.</p>
          </div>

          <!-- CONTACTO -->
          <section class="checkout-section">
            <div class="section-title">
              <span class="section-number">1</span>

              <div>
                <h2>Información de contacto</h2>
                <p>¿Dónde podemos contactarte?</p>
              </div>
            </div>

            <div class="form-grid">

              <div class="form-group full">
                <label for="email">Correo electrónico</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="tu@email.com"
                  autocomplete="email"
                  required
                />
              </div>

              <div class="form-group">
                <label for="firstName">Nombre</label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  placeholder="Tu nombre"
                  autocomplete="given-name"
                  required
                />
              </div>

              <div class="form-group">
                <label for="lastName">Apellido</label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  placeholder="Tu apellido"
                  autocomplete="family-name"
                  required
                />
              </div>

              <div class="form-group full">
                <label for="phone">Teléfono</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="+503 0000-0000"
                  autocomplete="tel"
                  required
                />
              </div>

            </div>
          </section>

          <!-- ENVÍO -->
          <section class="checkout-section">
            <div class="section-title">
              <span class="section-number">2</span>

              <div>
                <h2>Dirección de envío</h2>
                <p>¿Dónde entregaremos tu pedido?</p>
              </div>
            </div>

            <div class="form-grid">

              <div class="form-group full">
                <label for="country">País</label>

                <select id="country" name="country" required>
                  <option value="">Selecciona un país</option>
                  <option value="SV">El Salvador</option>
                  <option value="GT">Guatemala</option>
                  <option value="HN">Honduras</option>
                  <option value="NI">Nicaragua</option>
                  <option value="CR">Costa Rica</option>
                  <option value="PA">Panamá</option>
                  <option value="MX">México</option>
                  <option value="US">Estados Unidos</option>
                </select>
              </div>

              <div class="form-group">
                <label for="city">Ciudad</label>
                <input
                  type="text"
                  id="city"
                  name="city"
                  placeholder="Ciudad"
                  autocomplete="address-level2"
                  required
                />
              </div>

              <div class="form-group">
                <label for="department">Departamento / Estado</label>
                <input
                  type="text"
                  id="department"
                  name="department"
                  placeholder="Departamento"
                  autocomplete="address-level1"
                  required
                />
              </div>

              <div class="form-group full">
                <label for="address">Dirección</label>

                <textarea
                  id="address"
                  name="address"
                  rows="3"
                  placeholder="Calle, avenida, número de casa, colonia, etc."
                  autocomplete="street-address"
                  required
                ></textarea>
              </div>

              <div class="form-group">
                <label for="postalCode">Código postal</label>

                <input
                  type="text"
                  id="postalCode"
                  name="postalCode"
                  placeholder="Código postal"
                  autocomplete="postal-code"
                />
              </div>

              <div class="form-group">
                <label for="reference">Referencia</label>

                <input
                  type="text"
                  id="reference"
                  name="reference"
                  placeholder="Punto de referencia"
                />
              </div>

            </div>
          </section>

          <!-- MÉTODO DE PAGO -->
          <section class="checkout-section">
            <div class="section-title">
              <span class="section-number">3</span>

              <div>
                <h2>Método de pago</h2>
                <p>Selecciona cómo deseas pagar.</p>
              </div>
            </div>

            <div class="payment-options">

              <label class="payment-option selected">
                <input
                  type="radio"
                  name="payment"
                  value="card"
                  checked
                />

                <div class="payment-icon">💳</div>

                <div class="payment-info">
                  <strong>Tarjeta de crédito o débito</strong>
                  <span>Visa, Mastercard y otras tarjetas</span>
                </div>

                <span class="payment-check">✓</span>
              </label>

              <label class="payment-option">
                <input
                  type="radio"
                  name="payment"
                  value="transfer"
                />

                <div class="payment-icon">🏦</div>

                <div class="payment-info">
                  <strong>Transferencia bancaria</strong>
                  <span>Recibirás las instrucciones después del pedido</span>
                </div>

                <span class="payment-check">✓</span>
              </label>

            </div>

            <!-- FORMULARIO TARJETA -->
            <div id="card-form" class="card-form">

              <div class="form-grid">

                <div class="form-group full">
                  <label for="cardNumber">Número de tarjeta</label>

                  <input
                    type="text"
                    id="cardNumber"
                    placeholder="0000 0000 0000 0000"
                    inputmode="numeric"
                    autocomplete="cc-number"
                  />
                </div>

                <div class="form-group">
                  <label for="cardName">Nombre en la tarjeta</label>

                  <input
                    type="text"
                    id="cardName"
                    placeholder="Nombre completo"
                    autocomplete="cc-name"
                  />
                </div>

                <div class="form-group">
                  <label for="expiration">Vencimiento</label>

                  <input
                    type="text"
                    id="expiration"
                    placeholder="MM/AA"
                    autocomplete="cc-exp"
                  />
                </div>

                <div class="form-group">
                  <label for="cvv">CVV</label>

                  <input
                    type="password"
                    id="cvv"
                    placeholder="•••"
                    maxlength="4"
                    inputmode="numeric"
                    autocomplete="cc-csc"
                  />
                </div>

              </div>

              <div class="secure-message">
                🔒 Tus datos de pago serán procesados de forma segura.
              </div>

            </div>
          </section>

          <!-- NOTAS -->
          <section class="checkout-section">
            <div class="section-title">
              <span class="section-number">4</span>

              <div>
                <h2>Notas del pedido</h2>
                <p>Opcional</p>
              </div>
            </div>

            <div class="form-group">
              <textarea
                id="orderNotes"
                name="orderNotes"
                rows="4"
                placeholder="¿Hay alguna indicación especial para tu pedido?"
              ></textarea>
            </div>
          </section>

        </section>

        <!-- RESUMEN -->
        <aside class="checkout-summary">

          <div class="summary-card">

            <div class="summary-header">
              <h2>Tu pedido</h2>
              <span id="summary-count">0 productos</span>
            </div>

            <div id="summary-items" class="summary-items">
              <!-- Productos generados por JavaScript -->
            </div>

            <div id="empty-checkout" class="empty-checkout">
              <div>🛍️</div>
              <p>No tienes productos en tu carrito.</p>
              <a href="/">Volver a la tienda</a>
            </div>

            <div class="summary-totals">

              <div class="summary-row">
                <span>Subtotal</span>
                <strong id="subtotal">$0.00</strong>
              </div>

              <div class="summary-row">
                <span>Envío</span>
                <strong id="shipping">$0.00</strong>
              </div>

              <div class="summary-row total-row">
                <span>Total</span>
                <strong id="total">$0.00</strong>
              </div>

            </div>

            <button
              type="button"
              id="place-order"
              class="place-order"
            >
              Confirmar pedido
            </button>

            <p class="terms">
              Al confirmar tu pedido aceptas nuestros
              <a href="#">términos y condiciones</a>.
            </p>

          </div>

        </aside>

      </div>
    </main>

    <!-- CONFIRMACIÓN -->
    <div id="success-modal" class="success-modal">
      <div class="success-card">

        <div class="success-icon">✓</div>

        <h2>¡Pedido recibido!</h2>

        <p>
          Gracias por comprar en TEKITI.
          Hemos recibido la información de tu pedido.
        </p>

        <div class="order-number">
          Pedido <strong id="order-number">TK-000000</strong>
        </div>

        <a href="/" class="success-button">
          Volver a TEKITI
        </a>

      </div>
    </div>

    <script>
      const CART_KEY = "tekiti-cart";

      interface CartItem {
        id?: string;
        name: string;
        price: number;
        quantity: number;
      }

      const summaryItems =
        document.querySelector("#summary-items") as HTMLElement;

      const emptyCheckout =
        document.querySelector("#empty-checkout") as HTMLElement;

      const summaryCount =
        document.querySelector("#summary-count") as HTMLElement;

      const subtotalElement =
        document.querySelector("#subtotal") as HTMLElement;

      const shippingElement =
        document.querySelector("#shipping") as HTMLElement;

      const totalElement =
        document.querySelector("#total") as HTMLElement;

      const placeOrderButton =
        document.querySelector("#place-order") as HTMLButtonElement;

      const successModal =
        document.querySelector("#success-modal") as HTMLElement;

      const orderNumber =
        document.querySelector("#order-number") as HTMLElement;

      function getCart(): CartItem[] {
        try {
          return JSON.parse(
            localStorage.getItem(CART_KEY) || "[]"
          );
        } catch {
          return [];
        }
      }

      function formatPrice(value: number) {
        return new Intl.NumberFormat("en-US", {
          style: "currency",
          currency: "USD",
        }).format(value);
      }

      function renderCheckout() {
        const cart = getCart();

        summaryItems.innerHTML = "";

        const totalProducts = cart.reduce(
          (total, item) => total + item.quantity,
          0
        );

        summaryCount.textContent =
          `${totalProducts} ${totalProducts === 1 ? "producto" : "productos"}`;

        if (cart.length === 0) {
          summaryItems.style.display = "none";
          emptyCheckout.style.display = "flex";

          subtotalElement.textContent = "$0.00";
          shippingElement.textContent = "$0.00";
          totalElement.textContent = "$0.00";

          placeOrderButton.disabled = true;

          return;
        }

        summaryItems.style.display = "flex";
        emptyCheckout.style.display = "none";
        placeOrderButton.disabled = false;

        let subtotal = 0;

        cart.forEach((item) => {
          subtotal += item.price * item.quantity;

          const itemElement = document.createElement("div");

          itemElement.className = "summary-item";

          itemElement.innerHTML = `
            <div class="summary-item-quantity">
              ${item.quantity}
            </div>

            <div class="summary-item-info">
              <strong>${item.name}</strong>
              <span>
                ${item.quantity} × ${formatPrice(item.price)}
              </span>
            </div>

            <strong class="summary-item-price">
              ${formatPrice(item.price * item.quantity)}
            </strong>
          `;

          summaryItems.appendChild(itemElement);
        });

        /*
         * Por ahora usamos un costo fijo de envío.
         * Más adelante podremos calcularlo según:
         * país + departamento + peso + método de envío.
         */
        const shipping = subtotal >= 100 ? 0 : 7.5;

        const total = subtotal + shipping;

        subtotalElement.textContent = formatPrice(subtotal);

        shippingElement.textContent =
          shipping === 0
            ? "Gratis"
            : formatPrice(shipping);

        totalElement.textContent = formatPrice(total);
      }

      /*
       * Selección del método de pago
       */
      const paymentOptions =
        document.querySelectorAll(".payment-option");

      const cardForm =
        document.querySelector("#card-form") as HTMLElement;

      paymentOptions.forEach((option) => {
        option.addEventListener("click", () => {

          paymentOptions.forEach((item) => {
            item.classList.remove("selected");
          });

          option.classList.add("selected");

          const radio =
            option.querySelector(
              'input[type="radio"]'
            ) as HTMLInputElement;

          radio.checked = true;

          if (radio.value === "card") {
            cardForm.style.display = "block";
          } else {
            cardForm.style.display = "none";
          }
        });
      });

      /*
       * Confirmar pedido
       */
    
        placeOrderButton.addEventListener("click", () => {
        const cart = getCart();

        if (cart.length === 0) {
            return;
        }

        const requiredFields = document.querySelectorAll(
            "input[required], select[required], textarea[required]"
        );

        let valid = true;

        requiredFields.forEach((field) => {
            const input = field as HTMLInputElement;

            if (!input.value.trim()) {
            input.classList.add("error");
            valid = false;
            } else {
            input.classList.remove("error");
            }
        });

        if (!valid) {
            const firstError =
            document.querySelector(".error") as HTMLElement;

            firstError?.focus();

            return;
        }

        // Deshabilitar el botón mientras se procesa el pedido
        placeOrderButton.disabled = true;
        placeOrderButton.textContent = "Procesando pedido...";

        // Simulación temporal del procesamiento
        setTimeout(() => {
            const randomNumber =
            Math.floor(100000 + Math.random() * 900000);

            orderNumber.textContent = `TK-${randomNumber}`;

            successModal.classList.add("visible");

            // Vaciar el carrito después de confirmar el pedido
            localStorage.removeItem(CART_KEY);

            // Actualizar el resumen del checkout
            renderCheckout();

            // Avisar al resto de la aplicación que el carrito cambió
            window.dispatchEvent(
            new StorageEvent("storage", {
                key: CART_KEY,
                newValue: null,
            })
            );
        }, 800);
        });

      /*
       * Actualizar si otra pestaña modifica el carrito
       */
      window.addEventListener("storage", (event) => {
        if (event.key === CART_KEY) {
          renderCheckout();
        }
      });

      renderCheckout();
    </script>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background: #f7f4ef;
        color: #252525;
        font-family: Arial, Helvetica, sans-serif;
      }

      :global(button),
      :global(input),
      :global(select),
      :global(textarea) {
        font: inherit;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      .checkout-header {
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 5%;
        background: #faf8f3;
        border-bottom: 1px solid #e7e0d5;
      }

      .brand {
        color: #252525;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.8rem;
        font-weight: 700;
        letter-spacing: 0.16em;
      }

      .secure-checkout {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #716b63;
        font-size: 0.8rem;
      }

      .checkout-page {
        padding: 50px 5% 80px;
      }

      .checkout-container {
        width: min(1180px, 100%);
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(320px, 0.9fr);
        gap: 45px;
        align-items: start;
      }

      .page-heading {
        margin-bottom: 35px;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 18px;
        color: #b85c38;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .page-heading h1 {
        margin: 0 0 8px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 500;
      }

      .page-heading p {
        margin: 0;
        color: #817a72;
        font-size: 0.9rem;
      }

      .checkout-section {
        margin-bottom: 24px;
        padding: 30px;
        background: #fff;
        border: 1px solid #e7e0d5;
      }

      .section-title {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 25px;
      }

      .section-number {
        width: 30px;
        height: 30px;
        flex: 0 0 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #252525;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
      }

      .section-title h2 {
        margin: 0 0 5px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.2rem;
        font-weight: 600;
      }

      .section-title p {
        margin: 0;
        color: #8a837a;
        font-size: 0.78rem;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
      }

      .form-group.full {
        grid-column: 1 / -1;
      }

      .form-group label {
        color: #48433e;
        font-size: 0.76rem;
        font-weight: 600;
      }

      .form-group input,
      .form-group select,
      .form-group textarea {
        width: 100%;
        padding: 13px 14px;
        border: 1px solid #dcd4c9;
        border-radius: 0;
        outline: none;
        background: #fff;
        color: #252525;
        font-size: 0.85rem;
        transition: border-color 0.2s ease;
      }

      .form-group textarea {
        resize: vertical;
        min-height: 100px;
      }

      .form-group input:focus,
      .form-group select:focus,
      .form-group textarea:focus {
        border-color: #b85c38;
      }

      .form-group input.error,
      .form-group select.error,
      .form-group textarea.error {
        border-color: #c74747;
      }

      .payment-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .payment-option {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px;
        border: 1px solid #ded7cc;
        cursor: pointer;
        transition:
          border-color 0.2s ease,
          background 0.2s ease;
      }

      .payment-option.selected {
        border-color: #b85c38;
        background: #fcf8f4;
      }

      .payment-option input {
        position: absolute;
        opacity: 0;
      }

      .payment-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1ebe3;
        border-radius: 50%;
        font-size: 1rem;
      }

      .payment-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .payment-info strong {
        font-size: 0.82rem;
      }

      .payment-info span {
        color: #898177;
        font-size: 0.72rem;
      }

      .payment-check {
        margin-left: auto;
        color: #b85c38;
        opacity: 0;
        font-weight: 700;
      }

      .payment-option.selected .payment-check {
        opacity: 1;
      }

      .card-form {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #ebe4da;
      }

      .secure-message {
        margin-top: 18px;
        padding: 13px;
        background: #f7f3ed;
        color: #777068;
        font-size: 0.72rem;
      }

      /* RESUMEN */

      .checkout-summary {
        position: sticky;
        top: 25px;
      }

      .summary-card {
        padding: 28px;
        background: #fff;
        border: 1px solid #e7e0d5;
      }

      .summary-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 20px;
        border-bottom: 1px solid #ebe4da;
      }

      .summary-header h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.3rem;
      }

      .summary-header span {
        color: #898177;
        font-size: 0.72rem;
      }

      .summary-items {
        display: flex;
        flex-direction: column;
      }

      .summary-item {
        display: grid;
        grid-template-columns: 30px 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 17px 0;
        border-bottom: 1px solid #eee8df;
      }

      .summary-item-quantity {
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0e9de;
        color: #555049;
        font-size: 0.7rem;
        font-weight: 700;
      }

      .summary-item-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
      }

      .summary-item-info strong {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 0.82rem;
      }

      .summary-item-info span {
        color: #898177;
        font-size: 0.68rem;
      }

      .summary-item-price {
        font-size: 0.78rem;
        white-space: nowrap;
      }

      .empty-checkout {
        min-height: 220px;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #8a837a;
      }

      .empty-checkout div {
        margin-bottom: 12px;
        font-size: 2rem;
      }

      .empty-checkout p {
        margin: 0 0 15px;
        font-size: 0.8rem;
      }

      .empty-checkout a {
        color: #b85c38;
        font-size: 0.78rem;
        font-weight: 600;
      }

      .summary-totals {
        padding: 20px 0;
      }

      .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 12px;
        color: #777068;
        font-size: 0.8rem;
      }

      .summary-row strong {
        color: #252525;
      }

      .total-row {
        margin: 20px 0 0;
        padding-top: 18px;
        border-top: 1px solid #e7e0d5;
        color: #252525;
        font-size: 1rem;
      }

      .total-row strong {
        color: #b85c38;
        font-size: 1.2rem;
      }

      .place-order {
        width: 100%;
        padding: 16px;
        border: 0;
        background: #252525;
        color: #fff;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
