---
// src/pages/products/[slug].astro
import SEO from '../../components/SEO.astro';

export const prerender = false;

const { slug } = Astro.params;

let product = null;
let errorMessage = null;

try {
  const response = await fetch(`http://127.0.0.1:3000/api/products/slug/${slug}`);
  const result = await response.json();

  if (result.success && result.data) {
    product = result.data;
  } else {
    errorMessage = "El producto que buscas no existe o ya no está disponible.";
  }
} catch (err) {
  console.error("Error al obtener producto:", err);
  errorMessage = "No se pudo conectar con el servidor.";
}

// Datos estructurados para Google (Schema.org / Product)
const productSchema = product ? {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "description": product.description || "Pieza artesanal elaborada con dedicación y técnicas tradicionales.",
  "image": product.images && product.images.length > 0 ? product.images[0] : '',
  "brand": {
    "@type": "Brand",
    "name": product.brand || "TEKITI"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "USD",
    "price": product.offerPrice ? product.offerPrice : product.price,
    "availability": product.stock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
  }
} : null;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO 
      title={product ? product.name : "Producto no encontrado"}
      description={product ? (product.description || `Compra ${product.name} en TEKITI. Artesanía de alta calidad.`) : "El producto que buscas no existe o ya no está disponible."}
      image={product && product.images && product.images.length > 0 ? product.images[0] : undefined}
      type="product"
    />

    {productSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    )}
  </head>
  <body>
    <!-- HEADER / NAVEGACIÓN -->
    <header class="store-header">
      <div class="brand">
        <a href="/">TEKITI</a>
        <span>Catálogo Artesanal</span>
      </div>
      <a href="/" class="back-link">← Volver al inicio</a>
    </header>

    <main class="main-container">
      {errorMessage || !product ? (
        <div class="error-container">
          <h2>Producto no encontrado</h2>
          <p>{errorMessage || "Lo sentimos, no pudimos encontrar este producto."}</p>
          <a href="/" class="btn-primary">Regresar a la tienda</a>
        </div>
      ) : (
        <div class="product-detail-grid">
          <!-- GALERÍA DE IMÁGENES -->
          <div class="product-gallery">
            <div class="main-image-container">
              <img 
                src={product.images && product.images.length > 0 ? product.images[0] : 'https://via.placeholder.com/400'} 
                alt={product.name} 
                class="main-img" 
                id="active-product-img"
              />
              {product.offerPrice && <span class="badge-offer">Oferta</span>}
            </div>
            
            {product.images && product.images.length > 1 && (
              <div class="thumbnails-list">
                {product.images.map((imgUrl: string, index: number) => (
                  <button 
                    type="button" 
                    class={`thumb-btn ${index === 0 ? 'active' : ''}`}
                    onclick={`document.getElementById('active-product-img').src='${imgUrl}'`}
                  >
                    <img src={imgUrl} alt={`${product.name} ${index + 1}`} />
                  </button>
                ))}
              </div>
            )}
          </div>

          <!-- INFORMACIÓN DEL PRODUCTO -->
          <div class="product-details-info">
            <span class="product-origin">📍 {product.origin || 'El Salvador'}</span>
            <h1 class="product-title">{product.name}</h1>
            
            <div class="product-pricing-box">
              {product.offerPrice ? (
                <>
                  <span class="price-offer">${Number(product.offerPrice).toFixed(2)}</span>
                  <span class="price-original">${Number(product.price).toFixed(2)}</span>
                </>
              ) : (
                <span class="price-normal">${Number(product.price).toFixed(2)}</span>
              )}
            </div>

            <p class="product-description">
              {product.description || "Pieza artesanal elaborada con dedicación y técnicas tradicionales."}
            </p>

            <!-- SECCIÓN META (Solo Stock) -->
            <div class="product-meta">
              <p><strong>Stock disponible:</strong> {product.stock > 0 ? `${product.stock} unidades` : 'Agotado'}</p>
            </div>

            <!-- BOTÓN PRINCIPAL DE AGREGAR AL CARRITO -->
            <button 
              type="button" 
              class="btn-add-cart" 
              disabled={product.stock <= 0}
              data-id={product.id}
              data-name={product.name}
              data-price={product.offerPrice ? product.offerPrice : product.price}
              data-image={product.images && product.images.length > 0 ? product.images[0] : ''}
            >
              {product.stock > 0 ? '🛒 Agregar al carrito' : 'Sin stock'}
            </button>
          </div>
        </div>
      )}
    </main>

    <style>
      :global(body) {
        margin: 0;
        background: #f7f4ef;
        color: #252525;
        font-family: Arial, Helvetica, sans-serif;
      }

      .store-header {
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 5%;
        background: #fff;
        border-bottom: 1px solid #e7e0d5;
      }

      .brand a {
        font-family: Georgia, serif;
        font-size: 1.5rem;
        letter-spacing: 0.1em;
        color: #252525;
        text-decoration: none;
        font-weight: bold;
      }

      .brand span {
        color: #898177;
        font-size: 0.75rem;
        text-transform: uppercase;
        margin-left: 10px;
      }

      .back-link {
        color: #b85c38;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
      }
      .back-link:hover { text-decoration: underline; }

      .main-container {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
      }

      .product-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        background: #fff;
        padding: 30px;
        border-radius: 12px;
        border: 1px solid #e7e0d5;
      }

      @media (max-width: 768px) {
        .product-detail-grid {
          grid-template-columns: 1fr;
        }
      }

      .main-image-container {
        position: relative;
        width: 100%;
        height: 380px;
        background: #faf8f3;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e7e0d5;
      }

      .main-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .badge-offer {
        position: absolute;
        top: 15px;
        left: 15px;
        background: #c74747;
        color: white;
        font-size: 0.75rem;
        font-weight: bold;
        padding: 5px 10px;
        border-radius: 4px;
        text-transform: uppercase;
      }

      .thumbnails-list {
        display: flex;
        gap: 10px;
        margin-top: 15px;
        overflow-x: auto;
      }

      .thumb-btn {
        width: 70px;
        height: 70px;
        border: 2px solid #e7e0d5;
        border-radius: 6px;
        padding: 0;
        background: #faf8f3;
        cursor: pointer;
        overflow: hidden;
      }

      .thumb-btn img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .thumb-btn:hover, .thumb-btn.active {
        border-color: #b85c38;
      }

      .product-origin {
        font-size: 0.85rem;
        color: #b85c38;
        font-weight: 600;
        text-transform: uppercase;
      }

      .product-title {
        font-family: Georgia, serif;
        font-size: 2rem;
        margin: 8px 0 15px 0;
        color: #252525;
      }

      .product-pricing-box {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
      }

      .price-normal, .price-offer {
        font-size: 1.6rem;
        font-weight: bold;
        color: #252525;
      }

      .price-offer {
        color: #b85c38;
      }

      .price-original {
        font-size: 1.1rem;
        text-decoration: line-through;
        color: #898177;
      }

      .product-description {
        color: #555;
        line-height: 1.6;
        margin-bottom: 20px;
      }

      .product-meta {
        border-top: 1px solid #e7e0d5;
        border-bottom: 1px solid #e7e0d5;
        padding: 15px 0;
        margin-bottom: 25px;
        font-size: 0.9rem;
        color: #666;
      }

      .product-meta p {
        margin: 5px 0;
      }

      .btn-add-cart {
        width: 100%;
        background: #b85c38;
        color: white;
        border: none;
        padding: 14px;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.2s;
      }

      .btn-add-cart:hover:not(:disabled) {
        background: #964728;
      }

      .btn-add-cart:disabled {
        background: #ccc;
        cursor: not-allowed;
      }

      .error-container {
        text-align: center;
        background: #fff;
        padding: 60px 20px;
        border-radius: 12px;
        border: 1px solid #e7e0d5;
      }

      .btn-primary {
        display: inline-block;
        margin-top: 15px;
        background: #252525;
        color: #fff;
        padding: 10px 20px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
        font-size: 0.9rem;
      }
      .btn-primary:hover { background: #b85c38; }
    </style>

    <script>
      const CART_KEY = "tekiti-cart";
      const addToCartBtn = document.querySelector('.btn-add-cart');

      if (addToCartBtn) {
        addToCartBtn.addEventListener('click', () => {
          const id = addToCartBtn.getAttribute('data-id');
          const name = addToCartBtn.getAttribute('data-name');
          const price = parseFloat(addToCartBtn.getAttribute('data-price') || '0');
          const image = addToCartBtn.getAttribute('data-image');

          if (!id || !name) {
            alert("Error al obtener la información del producto.");
            return;
          }

          const newItem = {
            id,
            name,
            price,
            image,
            quantity: 1
          };

          let cart = [];
          try {
            cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
          } catch (e) {
            cart = [];
          }

          const existingIndex = cart.findIndex((item: any) => String(item.id) === String(id));

          if (existingIndex > -1) {
            cart[existingIndex].quantity += 1;
          } else {
            cart.push(newItem);
          }

          localStorage.setItem(CART_KEY, JSON.stringify(cart));
          window.dispatchEvent(new StorageEvent('storage', { key: CART_KEY }));

          alert(`¡"${name}" se ha añadido al carrito!`);
        });
      }
    </script>
  </body>
</html>