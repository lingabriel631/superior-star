---
// src/pages/products/[slug].astro
import SEO from '../../components/SEO.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import Footer from '../../components/Footer.astro';

export const prerender = false;

const { slug } = Astro.params;

let product = null;
let errorMessage = null;

try {
  const API_URL = import.meta.env.PUBLIC_API_URL || "https://superior-star.onrender.com";
  const response = await fetch(`${API_URL}/api/products/slug/${slug}`);
  const result = await response.json();

  if (result.success && result.data) {
    product = result.data;
  } else {
    errorMessage = "El producto que buscas no existe o ya no está disponible.";
  }
} catch (err) {
  console.error("Error al obtener producto:", err);
  errorMessage = "No se pudo conectar con el servidor.";
}

const mainImage =
  (product && product.images && product.images.length > 0 && product.images[0]) ||
  (product && product.image) ||
  "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=900&q=80";

const hasOffer = Boolean(product && ((product.isOffer && product.offerPrice) || product.offerPrice));
const activePrice = product ? (hasOffer ? Number(product.offerPrice) : Number(product.price)) : 0;

// Datos estructurados para Google (Schema.org / Product)
const productSchema = product ? {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "description": product.description || "Pieza artesanal elaborada con dedicación y técnicas inspiradas en la costa salvadoreña.",
  "image": mainImage,
  "brand": {
    "@type": "Brand",
    "name": "Costa Azul"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "USD",
    "price": activePrice.toFixed(2),
    "availability": product.stock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
  }
} : null;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO
      title={product ? `${product.name} | Costa Azul` : "Producto no encontrado | Costa Azul"}
      description={product ? (product.description || `Compra ${product.name} en Costa Azul. Piezas artesanales de El Salvador.`) : "El producto que buscas no existe o ya no está disponible."}
      image={product ? mainImage : undefined}
      type="product"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {productSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    )}
  </head>
  <body>
    <!-- BARRA DE NAVEGACIÓN -->
    <header class="store-header">
      <a href="/" class="brand" aria-label="Costa Azul Inicio">
        <svg class="brand-logo" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
          <circle cx="20" cy="14" r="6.5" fill="#E7DCC8" />
          <path d="M20 11V26M15.5 16H24.5M14 23C14 26.5 17 28.5 20 28.5C23 28.5 26 26.5 26 23" stroke="#002B5C" stroke-width="2.2" stroke-linecap="round" />
          <path d="M5 31C10 27.5 15 34.5 20 31C25 27.5 30 34.5 35 31" stroke="#002B5C" stroke-width="2.4" stroke-linecap="round" />
        </svg>
        <div class="brand-text">
          <span class="brand-name">COSTA AZUL</span>
          <span class="brand-sub">LOS CÓBANOS • EL SALVADOR</span>
        </div>
      </a>

      <nav class="nav-links" aria-label="Secciones de la tienda">
        <a href="/#inicio">Inicio</a>
        <a href="/#novedades">Novedades</a>
        <a href="/#ofertas">Ofertas</a>
        <a href="/#categorias">Categorías</a>
      </nav>

      <div class="header-actions">
        <a href="/cuenta" class="account-btn" aria-label="Mi cuenta">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21a8 8 0 0 0-16 0" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          <span>Cuenta</span>
        </a>

        <button type="button" class="cart-action cart-btn" aria-label="Abrir carrito de compras">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1" />
            <circle cx="20" cy="21" r="1" />
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
          </svg>
          <span class="cart-count" id="cart-count">0</span>
        </button>
      </div>
    </header>

    <main class="main-container">
      {errorMessage || !product ? (
        <div class="error-container">
          <span class="eyebrow">PIEZA NO DISPONIBLE</span>
          <h2>Producto no encontrado</h2>
          <p>{errorMessage || "Lo sentimos, no pudimos encontrar este producto."}</p>
          <a href="/" class="btn-primary">Regresar a la tienda</a>
        </div>
      ) : (
        <div class="product-detail-grid">
          <!-- GALERÍA DE IMÁGENES -->
          <div class="product-gallery">
            <div class="main-image-container">
              <img
                src={mainImage}
                alt={product.name}
                class="main-img"
                id="active-product-img"
              />
              {hasOffer && <span class="badge-offer">Oferta</span>}
            </div>

            {product.images && product.images.length > 1 && (
              <div class="thumbnails-list">
                {product.images.map((imgUrl: string, index: number) => (
                  <button
                    type="button"
                    class={`thumb-btn ${index === 0 ? 'active' : ''}`}
                    data-thumb-src={imgUrl}
                    aria-label={`Ver imagen ${index + 1} de ${product.name}`}
                  >
                    <img src={imgUrl} alt={`${product.name} ${index + 1}`} />
                  </button>
                ))}
              </div>
            )}
          </div>

          <!-- INFORMACIÓN DEL PRODUCTO -->
          <div class="product-details-info">
            {product.category?.name && (
              <span class="product-category">{product.category.name}</span>
            )}
            <h1 class="product-title">{product.name}</h1>

            <div class="product-pricing-box">
              {hasOffer ? (
                <>
                  <span class="price-offer">${Number(product.offerPrice).toFixed(2)}</span>
                  <span class="price-original">${Number(product.price).toFixed(2)}</span>
                </>
              ) : (
                <span class="price-normal">${Number(product.price).toFixed(2)}</span>
              )}
            </div>

            {product.description && (
              <p class="product-description">{product.description}</p>
            )}

            <!-- STOCK -->
            <div class="product-meta">
              <p><strong>Stock disponible:</strong> {product.stock > 0 ? `${product.stock} unidades` : 'Agotado'}</p>
            </div>

            <!-- CONTROL DE CANTIDAD PARA CARRITO -->
            {product.stock > 0 ? (
              <div class="detail-cart-box">
                <div class="cart-label">Cantidad en el carrito</div>
                <div
                  class="quantity-control"
                  data-product-id={product.id}
                  data-product-name={product.name}
                  data-product-price={activePrice}
                  data-product-image={mainImage}
                  data-max-stock={product.stock}
                >
                  <button type="button" class="quantity-button decrease" aria-label="Quitar una unidad">−</button>
                  <span class="quantity" aria-live="polite">0</span>
                  <button type="button" class="quantity-button increase" aria-label="Agregar una unidad">+</button>
                </div>
                <p class="cart-feedback" id="cart-feedback" aria-live="polite"></p>
              </div>
            ) : (
              <button type="button" class="btn-out-of-stock" disabled>
                Sin stock
              </button>
            )}
          </div>
        </div>
      )}
    </main>

    <Footer />
    <CartDrawer />

    <style>
      :global(body) {
        margin: 0;
        background: #FAF8F5;
        color: #1E293B;
        font-family: 'Plus Jakarta Sans', sans-serif;
      }

      /* ========================================
         BARRA DE NAVEGACIÓN
      ======================================== */
      .store-header {
        position: sticky;
        top: 0;
        z-index: 50;
        height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 0 5%;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #E7DCC8;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
      }

      .brand-text {
        display: flex;
        flex-direction: column;
      }

      .brand-name {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        color: #002B5C;
        line-height: 1.1;
      }

      .brand-sub {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: #64748B;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .nav-links a {
        color: #002B5C;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        padding: 6px 0;
        border-bottom: 2px solid transparent;
        transition: border-color 0.2s ease;
      }

      .nav-links a:hover {
        border-bottom-color: #002B5C;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .account-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px;
        border-radius: 999px;
        background: #E7DCC8;
        color: #002B5C;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease;
      }

      .account-btn:hover {
        background: #002B5C;
        color: #FFFFFF;
      }

      .cart-btn {
        position: relative;
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1.5px solid #002B5C;
        background: #FFFFFF;
        color: #002B5C;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
      }

      .cart-btn:hover {
        background: #002B5C;
        color: #FFFFFF;
        transform: translateY(-1px);
      }

      .cart-count {
        position: absolute;
        top: -5px;
        right: -5px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: #002B5C;
        color: #E7DCC8;
        border: 1.5px solid #FFFFFF;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 800;
        display: none;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
      }

      .cart-count.visible {
        display: inline-flex;
      }

      /* ========================================
         DETALLE DEL PRODUCTO
      ======================================== */
      .main-container {
        width: min(1140px, 92%);
        margin: 48px auto 80px;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 10px;
        color: #002B5C;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.16em;
      }

      .product-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 42px;
        background: #FFFFFF;
        padding: 34px;
        border-radius: 20px;
        border: 1px solid #E7DCC8;
        box-shadow: 0 8px 24px rgba(0, 43, 92, 0.05);
      }

      @media (max-width: 820px) {
        .nav-links {
          display: none;
        }

        .account-btn span {
          display: none;
        }

        .account-btn {
          width: 42px;
          height: 42px;
          padding: 0;
          justify-content: center;
        }

        .product-detail-grid {
          grid-template-columns: 1fr;
          padding: 22px;
          gap: 28px;
        }
      }

      .main-image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        background: #FAF8F5;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #E7DCC8;
      }

      .main-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .badge-offer {
        position: absolute;
        top: 14px;
        left: 14px;
        background: #002B5C;
        color: #E7DCC8;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 999px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .thumbnails-list {
        display: flex;
        gap: 10px;
        margin-top: 14px;
        overflow-x: auto;
        padding-bottom: 4px;
      }

      .thumb-btn {
        width: 72px;
        height: 72px;
        flex: 0 0 72px;
        border: 2px solid #E7DCC8;
        border-radius: 10px;
        padding: 0;
        background: #FAF8F5;
        cursor: pointer;
        overflow: hidden;
        transition: border-color 0.2s ease, transform 0.2s ease;
      }

      .thumb-btn img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .thumb-btn:hover,
      .thumb-btn.active {
        border-color: #002B5C;
        transform: translateY(-2px);
      }

      .product-details-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .product-category {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.75rem;
        color: #002B5C;
        background: #E7DCC8;
        width: fit-content;
        padding: 6px 14px;
        border-radius: 999px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 14px;
      }

      .product-title {
        font-family: 'Montserrat', sans-serif;
        font-size: clamp(1.8rem, 3.5vw, 2.5rem);
        font-weight: 800;
        line-height: 1.15;
        margin: 0 0 16px 0;
        color: #002B5C;
      }

      .product-pricing-box {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
      }

      .price-normal,
      .price-offer {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.75rem;
        font-weight: 800;
        color: #002B5C;
      }

      .price-original {
        font-size: 1.1rem;
        text-decoration: line-through;
        color: #94A3B8;
      }

      .product-description {
        color: #475569;
        font-size: 0.98rem;
        line-height: 1.7;
        margin: 0 0 22px 0;
      }

      .product-meta {
        border-top: 1px solid #E7DCC8;
        border-bottom: 1px solid #E7DCC8;
        padding: 16px 0;
        margin-bottom: 26px;
        font-size: 0.92rem;
        color: #334155;
      }

      .product-meta p {
        margin: 0;
      }

      .cart-label {
        margin-bottom: 10px;
        color: #64748B;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .quantity-control {
        width: 100%;
        min-height: 48px;
        display: grid;
        grid-template-columns: 52px minmax(0, 1fr) 52px;
        align-items: center;
        border-radius: 999px;
        border: 1.5px solid #002B5C;
        background: #002B5C;
        overflow: hidden;
      }

      .quantity-button {
        width: 52px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: #FFFFFF;
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transition: background 0.2s ease;
      }

      .quantity-button:hover {
        background: #001d40;
      }

      .quantity {
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-left: 1px solid rgba(255, 255, 255, 0.25);
        border-right: 1px solid rgba(255, 255, 255, 0.25);
        color: #FFFFFF;
        font-family: 'Montserrat', sans-serif;
        font-size: 1rem;
        font-weight: 700;
      }

      .btn-out-of-stock {
        width: 100%;
        background: #CBD5E1;
        color: #64748B;
        border: none;
        padding: 15px 24px;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        border-radius: 999px;
        cursor: not-allowed;
      }

      .cart-feedback {
        min-height: 22px;
        margin: 10px 0 0;
        font-size: 0.88rem;
        font-weight: 600;
        color: #002B5C;
        text-align: center;
      }

      .error-container {
        text-align: center;
        background: #FFFFFF;
        padding: 64px 24px;
        border-radius: 20px;
        border: 1px solid #E7DCC8;
      }

      .error-container h2 {
        margin: 0 0 10px;
        font-family: 'Montserrat', sans-serif;
        font-size: 1.7rem;
        font-weight: 800;
        color: #002B5C;
      }

      .error-container p {
        margin: 0 auto 20px;
        max-width: 440px;
        color: #5A6577;
        font-size: 0.95rem;
        line-height: 1.6;
      }

      .btn-primary {
        display: inline-block;
        background: #002B5C;
        color: #FFFFFF;
        padding: 12px 26px;
        border-radius: 999px;
        text-decoration: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.88rem;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .btn-primary:hover {
        background: #001d40;
        transform: translateY(-1px);
      }
    </style>

    <script>
      const CART_KEY = "tekiti-cart";
      const mainImgEl = document.querySelector<HTMLImageElement>("#active-product-img");
      const thumbButtons = document.querySelectorAll<HTMLButtonElement>(".thumb-btn");
      const control = document.querySelector<HTMLElement>(".quantity-control");
      const qtyEl = control?.querySelector<HTMLElement>(".quantity");
      const decreaseBtn = control?.querySelector<HTMLButtonElement>(".decrease");
      const increaseBtn = control?.querySelector<HTMLButtonElement>(".increase");
      const feedbackEl = document.querySelector<HTMLElement>("#cart-feedback");
      const cartCountEl = document.querySelector<HTMLElement>("#cart-count");

      function readCart(): any[] {
        try {
          const parsed = JSON.parse(localStorage.getItem(CART_KEY) || "[]");
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      }

      function writeCart(cart: any[]) {
        localStorage.setItem(CART_KEY, JSON.stringify(cart));
      }

      function getItemQuantity(productId: string): number {
        const cart = readCart();
        const found = cart.find((item) => String(item.id) === String(productId));
        return found ? Number(found.quantity || 0) : 0;
      }

      function syncDetailUI() {
        const cart = readCart();
        const total = cart.reduce((acc, item) => acc + Number(item.quantity || 0), 0);

        if (cartCountEl) {
          cartCountEl.textContent = String(total);
          cartCountEl.classList.toggle("visible", total > 0);
        }

        if (control && qtyEl) {
          const productId = control.dataset.productId || "";
          qtyEl.textContent = String(getItemQuantity(productId));
        }
      }

      function setItemQuantity(newQty: number) {
        if (!control) return;
        const productId = control.dataset.productId || "";
        const productName = control.dataset.productName || "";
        const price = Number(control.dataset.productPrice || 0);
        const image = control.dataset.productImage || "";
        const maxStock = Number(control.dataset.maxStock || Infinity);

        const clampedQty = Math.min(Math.max(0, newQty), maxStock);
        let cart = readCart();
        const idx = cart.findIndex((item) => String(item.id) === String(productId));

        if (clampedQty <= 0) {
          cart = cart.filter((item) => String(item.id) !== String(productId));
        } else if (idx > -1) {
          cart[idx].quantity = clampedQty;
        } else {
          cart.push({
            id: Number(productId) || productId,
            name: productName,
            price,
            image,
            quantity: clampedQty,
          });
        }

        writeCart(cart);
        syncDetailUI();
        window.dispatchEvent(new CustomEvent("tekiti-cart-updated"));

        if (feedbackEl) {
          feedbackEl.textContent =
            clampedQty > 0
              ? `"${productName}" en el carrito: ${clampedQty} ${clampedQty === 1 ? "unidad" : "unidades"}.`
              : `"${productName}" eliminado del carrito.`;
        }
      }

      thumbButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const src = btn.dataset.thumbSrc;
          if (src && mainImgEl) {
            mainImgEl.src = src;
          }
          thumbButtons.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
        });
      });

      if (control) {
        const productId = control.dataset.productId || "";

        decreaseBtn?.addEventListener("click", () => {
          const current = getItemQuantity(productId);
          setItemQuantity(current - 1);
        });

        increaseBtn?.addEventListener("click", () => {
          const current = getItemQuantity(productId);
          setItemQuantity(current + 1);
        });
      }

      window.addEventListener("tekiti-cart-updated", syncDetailUI);
      window.addEventListener("storage", (event) => {
        if (event.key === CART_KEY) {
          syncDetailUI();
        }
      });

      syncDetailUI();
    </script>
  </body>
</html>