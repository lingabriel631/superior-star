---
// src/pages/categorias/[slug].astro
import Footer from "../../components/Footer.astro";

export const prerender = false;

const { slug } = Astro.params;

let category = null;
let products = [];
let errorMessage = null;

try {
  const API_URL = import.meta.env.PUBLIC_API_URL || "https://superior-star.onrender.com";
  const response = await fetch(`${API_URL}/api/categories/${slug}`);
  const result = await response.json();

  if (result.success && result.data) {
    category = result.data.category || result.data;
    products = result.data.products || [];
  } else {
    errorMessage = "La categoría que buscas no existe o no tiene productos.";
  }
} catch (err) {
  console.error("Error al conectar con el servidor:", err);
  errorMessage = "No se pudo conectar con el servidor para cargar la categoría.";
}

const pageTitle = category ? `${category.name} | Costa Azul` : "Categoría | Costa Azul";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- BARRA DE NAVEGACIÓN -->
    <header class="store-header">
      <a href="/" class="brand" aria-label="Costa Azul Inicio">
        <svg class="brand-logo" viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
          <circle cx="20" cy="14" r="6.5" fill="#E7DCC8" />
          <path d="M20 11V26M15.5 16H24.5M14 23C14 26.5 17 28.5 20 28.5C23 28.5 26 26.5 26 23" stroke="#002B5C" stroke-width="2.2" stroke-linecap="round" />
          <path d="M5 31C10 27.5 15 34.5 20 31C25 27.5 30 34.5 35 31" stroke="#002B5C" stroke-width="2.4" stroke-linecap="round" />
        </svg>
        <div class="brand-text">
          <span class="brand-name">COSTA AZUL</span>
          <span class="brand-sub">LOS CÓBANOS • EL SALVADOR</span>
        </div>
      </a>

      <nav class="nav-links" aria-label="Secciones de la tienda">
        <a href="/#inicio">Inicio</a>
        <a href="/#novedades">Novedades</a>
        <a href="/#ofertas">Ofertas</a>
        <a href="/#categorias" class="active">Categorías</a>
      </nav>

      <a href="/#categorias" class="back-link">← Todas las categorías</a>
    </header>

    <main class="main-container">
      {errorMessage || !category ? (
        <div class="error-container">
          <span class="eyebrow">CATEGORÍA NO DISPONIBLE</span>
          <h2>Categoría no encontrada</h2>
          <p>{errorMessage || "Lo sentimos, no pudimos encontrar esta categoría."}</p>
          <a href="/" class="btn-primary">Regresar a la tienda</a>
        </div>
      ) : (
        <>
          <div class="category-header">
            <span class="eyebrow">COLECCIÓN • COSTA AZUL</span>
            <h1>{category.name}</h1>
            <p>
              {category.description ||
                `Explora nuestra selección de piezas artesanales y creaciones de la categoría ${category.name}.`}
            </p>
          </div>

          {products.length === 0 ? (
            <div class="empty-state">
              <p>No hay productos disponibles en esta categoría por el momento.</p>
              <a href="/" class="btn-primary">Explorar tienda</a>
            </div>
          ) : (
            <div class="products-grid">
              {products.map((product: any) => {
                const mainImg =
                  (product.images && product.images.length > 0 && product.images[0]) ||
                  product.image ||
                  "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80";

                const hasOffer = Boolean(product.isOffer && product.offerPrice) || Boolean(product.offerPrice);

                return (
                  <a href={`/products/${product.slug}`} class="product-card">
                    <div class="product-img-container">
                      <img src={mainImg} alt={product.name} class="product-img" loading="lazy" />
                      {hasOffer && <span class="badge-offer">Oferta</span>}
                    </div>
                    <div class="product-info">
                      <span class="product-origin">
                        {product.origin ? `📍 ${product.origin}` : "📍 El Salvador"}
                      </span>
                      <h3 class="product-name">{product.name}</h3>
                      <div class="product-pricing">
                        {hasOffer ? (
                          <>
                            <span class="price-offer">${Number(product.offerPrice).toFixed(2)}</span>
                            <span class="price-original">${Number(product.price).toFixed(2)}</span>
                          </>
                        ) : (
                          <span class="price-normal">${Number(product.price).toFixed(2)}</span>
                        )}
                      </div>
                      <span class="card-cta">Ver pieza</span>
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </>
      )}
    </main>

    <Footer />

    <style>
      :global(body) {
        margin: 0;
        background: #FAF8F5;
        color: #1E293B;
        font-family: 'Plus Jakarta Sans', sans-serif;
      }

      /* ========================================
         BARRA DE NAVEGACIÓN
      ======================================== */
      .store-header {
        position: sticky;
        top: 0;
        z-index: 50;
        height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 0 5%;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #E7DCC8;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
      }

      .brand-text {
        display: flex;
        flex-direction: column;
      }

      .brand-name {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        color: #002B5C;
        line-height: 1.1;
      }

      .brand-sub {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: #64748B;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .nav-links a {
        color: #002B5C;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        padding: 6px 0;
        border-bottom: 2px solid transparent;
        transition: border-color 0.2s ease, opacity 0.2s ease;
      }

      .nav-links a:hover,
      .nav-links a.active {
        border-bottom-color: #002B5C;
      }

      .back-link {
        padding: 9px 18px;
        border-radius: 999px;
        background: #E7DCC8;
        color: #002B5C;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.84rem;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease;
      }

      .back-link:hover {
        background: #002B5C;
        color: #FFFFFF;
      }

      /* ========================================
         CONTENEDOR Y ENCABEZADO DE CATEGORÍA
      ======================================== */
      .main-container {
        width: min(1200px, 92%);
        margin: 48px auto 80px;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 10px;
        color: #002B5C;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.16em;
      }

      .category-header {
        background: #E7DCC8;
        border-radius: 20px;
        padding: 36px 40px;
        margin-bottom: 42px;
      }

      .category-header h1 {
        font-family: 'Montserrat', sans-serif;
        font-size: clamp(1.9rem, 4vw, 2.8rem);
        font-weight: 800;
        margin: 0 0 10px 0;
        color: #002B5C;
      }

      .category-header p {
        margin: 0;
        max-width: 640px;
        color: #334155;
        font-size: 0.98rem;
        line-height: 1.65;
      }

      /* ========================================
         CUADRÍCULA DE PRODUCTOS
      ======================================== */
      .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 24px;
      }

      .product-card {
        background: #FFFFFF;
        border: 1px solid #E7DCC8;
        border-radius: 16px;
        padding: 14px;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 4px 14px rgba(0, 43, 92, 0.04);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        display: flex;
        flex-direction: column;
      }

      .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px rgba(0, 43, 92, 0.1);
      }

      .product-img-container {
        position: relative;
        width: 100%;
        aspect-ratio: 0.9;
        border-radius: 12px;
        overflow: hidden;
        background: #E7DCC8;
      }

      .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
      }

      .product-card:hover .product-img {
        transform: scale(1.04);
      }

      .badge-offer {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #002B5C;
        color: #E7DCC8;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.68rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 999px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .product-info {
        padding-top: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }

      .product-origin {
        font-size: 0.72rem;
        color: #64748B;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 6px;
      }

      .product-name {
        font-family: 'Montserrat', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.35;
        margin: 0 0 12px 0;
        color: #002B5C;
      }

      .product-pricing {
        margin-top: auto;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .price-normal,
      .price-offer {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 1.08rem;
        color: #002B5C;
      }

      .price-original {
        font-size: 0.88rem;
        text-decoration: line-through;
        color: #94A3B8;
      }

      .card-cta {
        margin-top: 14px;
        padding: 9px 16px;
        border-radius: 999px;
        background: #002B5C;
        color: #FFFFFF;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.84rem;
        font-weight: 700;
        text-align: center;
        transition: background 0.2s ease;
      }

      .product-card:hover .card-cta {
        background: #001d40;
      }

      /* ========================================
         ESTADOS VACÍO / ERROR
      ======================================== */
      .empty-state,
      .error-container {
        text-align: center;
        background: #FFFFFF;
        padding: 64px 24px;
        border-radius: 20px;
        border: 1px solid #E7DCC8;
      }

      .error-container h2 {
        margin: 0 0 10px;
        font-family: 'Montserrat', sans-serif;
        font-size: 1.7rem;
        font-weight: 800;
        color: #002B5C;
      }

      .empty-state p,
      .error-container p {
        margin: 0 auto 20px;
        max-width: 440px;
        color: #5A6577;
        font-size: 0.95rem;
        line-height: 1.6;
      }

      .btn-primary {
        display: inline-block;
        background: #002B5C;
        color: #FFFFFF;
        padding: 12px 26px;
        border-radius: 999px;
        text-decoration: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.88rem;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .btn-primary:hover {
        background: #001d40;
        transform: translateY(-1px);
      }

      @media (max-width: 820px) {
        .nav-links {
          display: none;
        }

        .category-header {
          padding: 28px 24px;
        }
      }
    </style>
  </body>
</html>