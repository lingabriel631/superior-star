---
// src/pages/admin/products.astro
// Aquí puedes realizar peticiones iniciales del lado del servidor si lo deseas, 
// o dejar que el cliente cargue la lista mediante fetch.
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Panel de Administración - Tekiti</title>
    <!-- Tailwind CSS (Asegúrate de tenerlo configurado en tu proyecto) -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-50 text-slate-800 min-h-screen p-6">
    <div class="max-w-7xl mx-auto space-y-6">
      
      <!-- Encabezado -->
      <header class="flex justify-between items-center bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <div>
          <h1 class="text-2xl font-bold text-slate-900">Administración de Productos</h1>
          <p class="text-sm text-slate-500">Gestiona el inventario, artesanos y detalles de las piezas artesanales.</p>
        </div>
        <button 
          id="openCreateModalBtn" 
          class="bg-amber-600 hover:bg-amber-700 text-white font-medium px-4 py-2 rounded-lg shadow transition"
        >
          + Nuevo Producto
        </button>
      </header>

      <!-- Tabla de Productos -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-slate-700 font-semibold text-left">
              <tr>
                <th class="px-4 py-3">Fotos</th>
                <th class="px-4 py-3">Producto</th>
                <th class="px-4 py-3">Artesano / Origen</th>
                <th class="px-4 py-3">Precio</th>
                <th class="px-4 py-3">Stock</th>
                <th class="px-4 py-3">Dimensiones</th>
                <th class="px-4 py-3 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="productsTableBody" class="divide-y divide-slate-200 text-slate-600">
              <!-- Los productos se cargan dinámicamente con JavaScript -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- MODAL DE CREACIÓN / EDICIÓN -->
    <div id="productModal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center p-4 z-50">
      <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 shadow-xl">
        <div class="flex justify-between items-center border-b pb-3 mb-4">
          <h3 id="modalTitle" class="text-xl font-bold text-slate-800">Crear Nuevo Producto</h3>
          <button id="closeModalBtn" class="text-slate-400 hover:text-slate-600 font-bold text-xl">&times;</button>
        </div>

        <form id="productForm" class="space-y-4">
          <input type="hidden" id="productId" name="productId" />

          <!-- Información Básica -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Nombre *</label>
              <input type="text" id="name" name="name" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Categoría ID *</label>
              <input type="number" id="categoryId" name="categoryId" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500" placeholder="ID de categoría" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Descripción</label>
            <textarea id="description" name="description" rows="2" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500"></textarea>
          </div>

          <!-- Precios y Stock -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Precio ($) *</label>
              <input type="number" step="0.01" id="price" name="price" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Precio Oferta ($)</label>
              <input type="number" step="0.01" id="offerPrice" name="offerPrice" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Stock</label>
              <input type="number" id="stock" name="stock" value="0" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500" />
            </div>
          </div>

          <!-- Artesano y Origen -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 border-t">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Artesano / Taller</label>
              <input type="text" id="artisan" name="artisan" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500" placeholder="Ej. Familia Ramos" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Origen (Municipio/Lugar)</label>
              <input type="text" id="origin" name="origin" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500" placeholder="Ej. Ilobasco" />
            </div>
          </div>

          <!-- Dimensiones y Peso -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Peso (lb/kg)</label>
              <input type="number" step="0.01" id="weight" name="weight" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Ancho (cm)</label>
              <input type="number" step="0.01" id="width" name="width" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Alto (cm)</label>
              <input type="number" step="0.01" id="height" name="height" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500" />
            </div>
          </div>

          <!-- Fotografías (Hasta 5 URLs) -->
          <div class="pt-2 border-t">
            <label class="block text-sm font-medium text-slate-700 mb-1">Fotografías del Producto (Hasta 5 URLs)</label>
            <p class="text-xs text-slate-400 mb-2">La primera URL será la imagen principal que se mostrará en el catálogo.</p>
            <div class="space-y-2">
              <input type="url" class="image-input w-full px-3 py-2 border rounded-lg text-sm" placeholder="URL Foto 1 (Principal)" />
              <input type="url" class="image-input w-full px-3 py-2 border rounded-lg text-sm" placeholder="URL Foto 2 (Opcional)" />
              <input type="url" class="image-input w-full px-3 py-2 border rounded-lg text-sm" placeholder="URL Foto 3 (Opcional)" />
              <input type="url" class="image-input w-full px-3 py-2 border rounded-lg text-sm" placeholder="URL Foto 4 (Opcional)" />
              <input type="url" class="image-input w-full px-3 py-2 border rounded-lg text-sm" placeholder="URL Foto 5 (Opcional)" />
            </div>
          </div>

          <!-- Botones de Acción -->
          <div class="flex justify-end space-x-3 pt-4 border-t">
            <button type="button" id="cancelModalBtn" class="px-4 py-2 border rounded-lg text-slate-600 hover:bg-slate-50">Cancelar</button>
            <button type="submit" class="px-5 py-2 bg-amber-600 hover:bg-amber-700 text-white font-medium rounded-lg shadow">Guardar</button>
          </div>
        </form>
      </div>
    </div>

    <!-- SCRIPT DE INTERACCIÓN -->
    <script>
      const API_URL = 'http://localhost:3000/api/products';
      
      const modal = document.getElementById('productModal');
      const openBtn = document.getElementById('openCreateModalBtn');
      const closeBtn = document.getElementById('closeModalBtn');
      const cancelBtn = document.getElementById('cancelModalBtn');
      const form = document.getElementById('productForm');
      const tableBody = document.getElementById('productsTableBody');

      // Abrir / Cerrar Modal
      openBtn.addEventListener('click', () => {
        form.reset();
        document.getElementById('productId').value = '';
        document.getElementById('modalTitle').textContent = 'Crear Nuevo Producto';
        modal.classList.remove('hidden');
      });

      const closeModal = () => modal.classList.add('hidden');
      closeBtn.addEventListener('click', closeModal);
      cancelBtn.addEventListener('click', closeModal);

      // Cargar productos al iniciar
      async function fetchProducts() {
        try {
          const res = await fetch(API_URL);
          const result = await res.json();
          if (result.success) {
            renderTable(result.data);
          }
        } catch (err) {
          console.error('Error al conectar con la API:', err);
        }
      }

      function renderTable(products) {
        tableBody.innerHTML = '';
        if (products.length === 0) {
          tableBody.innerHTML = `<tr><td colspan="7" class="text-center py-6 text-slate-400">No hay productos registrados.</td></tr>`;
          return;
        }

        products.forEach(p => {
          const images = p.images || [];
          const mainImg = images.length > 0 ? images[0] : 'https://via.placeholder.com/150';
          const extraCount = images.length > 1 ? images.length - 1 : 0;

          const dims = [];
          if (p.width) dims.path ? null : dims.push(`An: ${p.width}cm`);
          if (p.height) dims.push(`Al: ${p.height}cm`);
          if (p.weight) dims.push(`Peso: ${p.weight}lb`);
          const dimsText = dims.length > 0 ? dims.join(' | ') : 'N/A';

          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-50 transition border-b';
          tr.innerHTML = `
            <td class="px-4 py-3">
              <div class="relative w-12 h-12">
                <img src="${mainImg}" alt="${p.name}" class="w-12 h-12 object-cover rounded-lg border" />
                ${extraCount > 0 ? `<span class="absolute -top-1 -right-1 bg-amber-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">+${extraCount}</span>` : ''}
              </div>
            </td>
            <td class="px-4 py-3 font-semibold text-slate-800">
              ${p.name}
              <div class="text-xs text-slate-400 font-normal">${p.category?.name || 'Sin categoría'}</div>
            </td>
            <td class="px-4 py-3">
              <div class="font-medium">${p.artisan || 'No asignado'}</div>
              <div class="text-xs text-amber-700 font-semibold">${p.origin ? '📍 ' + p.origin : ''}</div>
            </td>
            <td class="px-4 py-3 font-semibold text-slate-800">$${Number(p.price).toFixed(2)}</td>
            <td class="px-4 py-3"><span class="px-2 py-1 bg-slate-100 rounded text-xs">${p.stock} unids.</span></td>
            <td class="px-4 py-3 text-xs text-slate-500">${dimsText}</td>
            <td class="px-4 py-3 text-right space-x-2">
              <button onclick="editProduct(${p.id})" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs rounded font-medium">Editar</button>
              <button onclick="deleteProduct(${p.id})" class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs rounded font-medium">Eliminar</button>
            </td>
          `;
          tableBody.appendChild(tr);
        });
      }

      // Enviar formulario (Crear o Actualizar)
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('productId').value;
        
        // Recopilar las URLs de las imágenes y filtrar las vacías
        const imageInputs = document.querySelectorAll('.image-input');
        const images = Array.from(imageInputs).map(i => i.value.trim()).filter(url => url !== '');

        const payload = {
          name: document.getElementById('name').value,
          slug: document.getElementById('name').value.toLowerCase().trim().replace(/[^\w\s-]/g, '').replace(/[\s_-]+/g, '-'),
          categoryId: Number(document.getElementById('categoryId').value),
          description: document.getElementById('description').value,
          price: Number(document.getElementById('price').value),
          offerPrice: document.getElementById('offerPrice').value ? Number(document.getElementById('offerPrice').value) : null,
          stock: Number(document.getElementById('stock').value),
          artisan: document.getElementById('artisan').value || null,
          origin: document.getElementById('origin').value || null,
          weight: document.getElementById('weight').value ? Number(document.getElementById('weight').value) : null,
          width: document.getElementById('width').value ? Number(document.getElementById('width').value) : null,
          height: document.getElementById('height').value ? Number(document.getElementById('height').value) : null,
          images: images
        };

        const url = id ? `${API_URL}/${id}` : API_URL;
        const method = id ? 'PUT' : 'POST';

        try {
          const res = await fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const result = await res.json();

          if (result.success) {
            closeModal();
            fetchProducts();
          } else {
            alert('Error: ' + result.message);
          }
        } catch (err) {
          console.error('Error al guardar:', err);
          alert('Error al conectar con el servidor');
        }
      });

      // Cargar datos para editar
      window.editProduct = async function(id) {
        try {
          const res = await fetch(`${API_URL}/${id}`);
          const result = await res.json();
          if (result.success) {
            const p = result.data;
            document.getElementById('productId').value = p.id;
            document.getElementById('name').value = p.name;
            document.getElementById('categoryId').value = p.categoryId;
            document.getElementById('description').value = p.description || '';
            document.getElementById('price').value = p.price;
            document.getElementById('offerPrice').value = p.offerPrice || '';
            document.getElementById('stock').value = p.stock;
            document.getElementById('artisan').value = p.artisan || '';
            document.getElementById('origin').value = p.origin || '';
            document.getElementById('weight').value = p.weight || '';
            document.getElementById('width').value = p.width || '';
            document.getElementById('height').value = p.height || '';

            const imageInputs = document.querySelectorAll('.image-input');
            imageInputs.forEach((input, idx) => {
              input.value = (p.images && p.images[idx]) ? p.images[idx] : '';
            });

            document.getElementById('modalTitle').textContent = 'Editar Producto';
            modal.classList.remove('hidden');
          }
        } catch (err) {
          console.error('Error al cargar producto:', err);
        }
      };

      // Eliminar producto
      window.deleteProduct = async function(id) {
        if (!confirm('¿Estás seguro de eliminar este producto?')) return;
        try {
          const res = await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
          const result = await res.json();
          if (result.success) {
            fetchProducts();
          } else {
            alert('Error: ' + result.message);
          }
        } catch (err) {
          console.error('Error al eliminar:', err);
        }
      };

      // Inicializar carga de tabla
      fetchProducts();
    </script>
  </body>
</html>