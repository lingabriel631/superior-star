---
// src/pages/admin/dashboard.astro
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Tekiti - Panel de Administración</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <!-- Navbar -->
    <header class="navbar">
      <div class="nav-brand">
        <h1>Tekiti Admin</h1>
        <span class="badge">Productos</span>
      </div>
      <button id="btn-logout" class="btn-logout">
        Cerrar Sesión
      </button>
    </header>

    <!-- Main Content -->
    <main class="main-container">
      <div class="section-header">
        <div>
          <h2>Gestión de Productos</h2>
          <p>Crea, edita o elimina productos del catálogo</p>
        </div>
        <button id="btn-open-create-modal" class="btn-primary">
          + Nuevo Producto
        </button>
      </div>

      <!-- Tabla de Productos -->
      <div class="table-card">
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Descripción</th>
                <th class="text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="products-list">
              <tr>
                <td colspan="5" class="text-center">Cargando productos...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <!-- Modal Form (Crear / Editar) -->
    <div id="product-modal" class="modal-overlay hidden">
      <div class="modal-card">
        <h3 id="modal-title">Nuevo Producto</h3>
        
        <form id="product-form">
          <input type="hidden" id="product-id" />

          <div class="form-group">
            <label for="product-name">Nombre del Producto</label>
            <input 
              type="text" 
              id="product-name" 
              required 
              placeholder="Ej. Taza Artesanal Tekiti"
            />
          </div>

          <div class="form-group">
            <label for="product-price">Precio ($)</label>
            <input 
              type="number" 
              step="0.01" 
              id="product-price" 
              required 
              placeholder="15.00"
            />
          </div>

          <div class="form-group">
            <label for="product-description">Descripción</label>
            <textarea 
              id="product-description" 
              rows="3" 
              placeholder="Detalles sobre el producto..."
            ></textarea>
          </div>

          <div id="modal-error" class="error-msg hidden"></div>

          <div class="modal-actions">
            <button type="button" id="btn-close-modal" class="btn-secondary">
              Cancelar
            </button>
            <button type="submit" class="btn-primary">
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>

    <style>
      body {
        margin: 0;
        background-color: #111827;
        color: #f3f4f6;
        font-family: system-ui, -apple-system, sans-serif;
        min-height: 100vh;
      }

      /* Navbar */
      .navbar {
        background-color: #1f2937;
        border-bottom: 1px solid #374151;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .nav-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .navbar h1 {
        font-size: 1.25rem;
        font-weight: bold;
        color: #818cf8;
        margin: 0;
      }

      .badge {
        background-color: rgba(49, 46, 129, 0.6);
        color: #a5b4fc;
        font-size: 0.75rem;
        padding: 0.125rem 0.5rem;
        border-radius: 0.25rem;
        border: 1px solid #4338ca;
      }

      .btn-logout {
        background-color: rgba(220, 38, 38, 0.8);
        color: white;
        border: none;
        padding: 0.375rem 0.875rem;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        cursor: pointer;
        transition: background-color 0.2s;
      }

      .btn-logout:hover {
        background-color: #dc2626;
      }

      /* Main Container */
      .main-container {
        max-width: 1150px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }

      .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
      }

      .section-header h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0 0 0.25rem 0;
      }

      .section-header p {
        font-size: 0.875rem;
        color: #9ca3af;
        margin: 0;
      }

      .btn-primary {
        background-color: #4f46e5;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        font-weight: 500;
        font-size: 0.875rem;
        cursor: pointer;
        transition: background-color 0.2s;
      }

      .btn-primary:hover {
        background-color: #4338ca;
      }

      .btn-secondary {
        background-color: #374151;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        cursor: pointer;
        transition: background-color 0.2s;
      }

      .btn-secondary:hover {
        background-color: #4b5563;
      }

      /* Table */
      .table-card {
        background-color: #1f2937;
        border: 1px solid #374151;
        border-radius: 0.75rem;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }

      .table-responsive {
        overflow-x: auto;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.875rem;
      }

      thead {
        background-color: rgba(55, 65, 81, 0.5);
        color: #d1d5db;
        text-transform: uppercase;
        font-size: 0.75rem;
      }

      th, td {
        padding: 1rem;
      }

      tbody tr {
        border-top: 1px solid #374151;
        transition: background-color 0.15s;
      }

      tbody tr:hover {
        background-color: rgba(55, 65, 81, 0.3);
      }

      .text-center {
        text-align: center;
        color: #9ca3af;
      }

      .text-right {
        text-align: right;
      }

      .text-emerald {
        color: #34d399;
        font-weight: 600;
      }

      .text-mono {
        font-family: monospace;
        color: #9ca3af;
        font-size: 0.75rem;
      }

      .truncate {
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #9ca3af;
      }

      .btn-action-edit {
        background-color: rgba(217, 119, 6, 0.8);
        color: white;
        border: none;
        padding: 0.25rem 0.625rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        cursor: pointer;
        transition: background-color 0.2s;
        margin-right: 0.375rem;
      }

      .btn-action-edit:hover {
        background-color: #d97706;
      }

      .btn-action-delete {
        background-color: rgba(220, 38, 38, 0.8);
        color: white;
        border: none;
        padding: 0.25rem 0.625rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        cursor: pointer;
        transition: background-color 0.2s;
      }

      .btn-action-delete:hover {
        background-color: #dc2626;
      }

      /* Modal */
      .modal-overlay {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 50;
      }

      .modal-card {
        background-color: #1f2937;
        border: 1px solid #374151;
        padding: 1.5rem;
        border-radius: 0.75rem;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4);
      }

      .modal-card h3 {
        font-size: 1.25rem;
        font-weight: bold;
        margin-top: 0;
        margin-bottom: 1rem;
        color: #818cf8;
      }

      .form-group {
        margin-bottom: 1rem;
      }

      .form-group label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        margin-bottom: 0.375rem;
      }

      .form-group input,
      .form-group textarea {
        width: 100%;
        padding: 0.5rem 0.75rem;
        background-color: #374151;
        border: 1px solid #4b5563;
        border-radius: 0.375rem;
        color: #ffffff;
        box-sizing: border-box;
        outline: none;
        font-size: 0.875rem;
        font-family: inherit;
      }

      .form-group input:focus,
      .form-group textarea:focus {
        border-color: #6366f1;
      }

      .error-msg {
        background-color: rgba(127, 29, 29, 0.4);
        border: 1px solid #991b1b;
        color: #f87171;
        padding: 0.5rem;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        margin-bottom: 1rem;
      }

      .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 1.25rem;
      }

      .hidden {
        display: none;
      }
    </style>

    <script>
      const API_URL = 'http://localhost:3000/api';
      const token = localStorage.getItem('token');

      if (!token) {
        window.location.href = '/admin/login';
      }

      const productsTable = document.getElementById('products-list') as HTMLTableSectionElement;
      const modal = document.getElementById('product-modal') as HTMLDivElement;
      const productForm = document.getElementById('product-form') as HTMLFormElement;
      const modalTitle = document.getElementById('modal-title') as HTMLHeadingElement;
      const modalError = document.getElementById('modal-error') as HTMLDivElement;

      const inputId = document.getElementById('product-id') as HTMLInputElement;
      const inputName = document.getElementById('product-name') as HTMLInputElement;
      const inputPrice = document.getElementById('product-price') as HTMLInputElement;
      const inputDescription = document.getElementById('product-description') as HTMLTextAreaElement;

      document.getElementById('btn-logout')?.addEventListener('click', () => {
        localStorage.removeItem('token');
        window.location.href = '/admin/login';
      });

      document.getElementById('btn-open-create-modal')?.addEventListener('click', () => {
        modalTitle.textContent = 'Nuevo Producto';
        productForm.reset();
        inputId.value = '';
        modalError.classList.add('hidden');
        modal.classList.remove('hidden');
      });

      document.getElementById('btn-close-modal')?.addEventListener('click', () => {
        modal.classList.add('hidden');
      });
        async function loadProducts() {
        try {
            const res = await fetch(`${API_URL}/products`);
            const data = await res.json();

            if (!res.ok) throw new Error(data.message || 'Error al obtener productos');
            
            // --- CAMBIA ESTO ---
            // Asegurarnos de obtener el arreglo real de productos sin importar cómo lo envíe el backend
            const products = Array.isArray(data) ? data : (data.products || data.data || []);

            if (products.length === 0) {
            productsTable.innerHTML = `
                <tr>
                <td colspan="5" class="text-center">No hay productos registrados.</td>
                </tr>`;
            return;
            }

            productsTable.innerHTML = products.map((prod: any) => `
      
            <tr>
              <td class="text-mono">${prod.id}</td>
              <td style="font-weight: 500; color: #ffffff;">${prod.name}</td>
              <td class="text-emerald">$${Number(prod.price).toFixed(2)}</td>
              <td class="truncate">${prod.description || '—'}</td>
              <td class="text-right">
                <button 
                  onclick="editProduct('${prod.id}', '${encodeURIComponent(prod.name)}', ${prod.price}, '${encodeURIComponent(prod.description || '')}')"
                  class="btn-action-edit"
                >
                  Editar
                </button>
                <button 
                  onclick="deleteProduct('${prod.id}')"
                  class="btn-action-delete"
                >
                  Eliminar
                </button>
              </td>
            </tr>
          `).join('');
        } catch (err: any) {
          productsTable.innerHTML = `
            <tr>
              <td colspan="5" class="text-center" style="color: #f87171;">Error al cargar datos: ${err.message}</td>
            </tr>`;
        }
      }

      productForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        modalError.classList.add('hidden');

        const id = inputId.value;
        const name = inputName.value;
        const price = parseFloat(inputPrice.value);
        const description = inputDescription.value;

        const isEditing = Boolean(id);
        const url = isEditing ? `${API_URL}/products/${id}` : `${API_URL}/products`;
        const method = isEditing ? 'PUT' : 'POST';

        try {
          const res = await fetch(url, {
            method,
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ name, price, description })
          });

          const data = await res.json();

          if (!res.ok) {
            if (res.status === 401 || res.status === 403) {
              alert('Tu sesión ha expirado. Inicia sesión nuevamente.');
              localStorage.removeItem('token');
              window.location.href = '/admin/login';
              return;
            }
            throw new Error(data.message || 'No se pudo guardar el producto');
          }

          modal.classList.add('hidden');
          loadProducts();
        } catch (err: any) {
          modalError.textContent = err.message;
          modalError.classList.remove('hidden');
        }
      });

      (window as any).editProduct = (id: string, encodedName: string, price: number, encodedDesc: string) => {
        modalTitle.textContent = 'Editar Producto';
        inputId.value = id;
        inputName.value = decodeURIComponent(encodedName);
        inputPrice.value = price.toString();
        inputDescription.value = decodeURIComponent(encodedDesc);
        modalError.classList.add('hidden');
        modal.classList.remove('hidden');
      };

      (window as any).deleteProduct = async (id: string) => {
        if (!confirm('¿Estás seguro de que deseas eliminar este producto?')) return;

        try {
          const res = await fetch(`${API_URL}/products/${id}`, {
            method: 'DELETE',
            headers: {
              'Authorization': `Bearer ${token}`
            }
          });

          const data = await res.json();

          if (!res.ok) {
            if (res.status === 401 || res.status === 403) {
              alert('Tu sesión ha expirado. Inicia sesión nuevamente.');
              localStorage.removeItem('token');
              window.location.href = '/admin/login';
              return;
            }
            throw new Error(data.message || 'Error al eliminar');
          }

          loadProducts();
        } catch (err: any) {
          alert(`Error: ${err.message}`);
        }
      };

      loadProducts();
    </script>
  </body>
</html>