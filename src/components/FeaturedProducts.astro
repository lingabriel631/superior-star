---

const response = await fetch("http://localhost:3000/api/products");

const result = await response.json();

const products = result.success
  ? result.data.filter(
      (product: {
        isFeatured: boolean;
        isActive: boolean;
      }) =>
        product.isFeatured &&
        product.isActive
    )
  : [];

const formatPrice = (price: number) =>
  new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
  }).format(price);
---

<section class="featured" id="productos">
  <div class="container">

    <!-- ENCABEZADO -->
    <div class="section-header">
      <div>
        <span class="eyebrow">SELECCIÓN TEKITI</span>

        <h2>
          Los más
          <em> vendidos</em>
        </h2>
      </div>

      <p class="section-description">
        Descubre las piezas que más están eligiendo nuestros clientes.
        Cada una cuenta una historia y lleva consigo el trabajo de su creador.
      </p>
    </div>

    <!-- CARRUSEL -->
    <div class="products-wrapper">

      <button
        class="carousel-button carousel-prev"
        id="prev-products"
        aria-label="Productos anteriores"
        type="button"
      >
        ←
      </button>

      <div class="products-window">
        <div class="products-track" id="products-track">

          {
            products.map((product) => (
              <article class="product-card">

                <!-- IMAGEN -->
                <div class="product-image">

                  <img
                    src={product.image}
                    alt={product.name}
                    loading="lazy"
                  />

                  <span class="best-seller">
                    MÁS VENDIDO
                  </span>

                  <button
                    class="favorite"
                    type="button"
                    aria-label={`Agregar ${product.name} a favoritos`}
                  >
                    ♡
                  </button>

                </div>

                <!-- INFORMACIÓN -->
                <div class="product-info">

                  <span class="product-category">
                    {product.category}
                  </span>

                  <h3>
                    {product.name}
                  </h3>

                  <div class="product-price">
                    {formatPrice(product.price)}
                  </div>

                  <!-- LEYENDA -->
                  <div class="cart-label">
                    Agregar al carrito
                  </div>

                  <!-- SELECTOR DE CANTIDAD -->
                  <div
                    class="quantity-control"
                    data-product={product.name}
                    data-price={product.price}
                    data-id={product.id}
                  >

                    <button
                      type="button"
                      class="quantity-button decrease"
                      aria-label={`Quitar una unidad de ${product.name}`}
                    >
                      −
                    </button>

                    <span
                      class="quantity"
                      aria-live="polite"
                    >
                      0
                    </span>

                    <button
                      type="button"
                      class="quantity-button increase"
                      aria-label={`Agregar una unidad de ${product.name}`}
                    >
                      +
                    </button>

                  </div>

                </div>

              </article>
            ))
          }

        </div>
      </div>

      <button
        class="carousel-button carousel-next"
        id="next-products"
        aria-label="Productos siguientes"
        type="button"
      >
        →
      </button>

    </div>

    <!-- INFORMACIÓN DEL CARRUSEL -->
    <div class="carousel-footer">

      <div class="progress">
        <div
          class="progress-bar"
          id="products-progress"
        ></div>
      </div>

      <div
        class="product-counter"
        id="products-counter"
      >
        01 — 04
      </div>

    </div>

  </div>
</section>

<style>
  .featured {
    padding: 100px 0;
    background: #faf8f3;
  }

  .container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }

  /* =========================
     ENCABEZADO
  ========================= */

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 50px;
    margin-bottom: 55px;
  }

  .eyebrow {
    display: block;
    margin-bottom: 14px;
    color: #b85c38;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  h2 {
    margin: 0;
    color: #252525;
    font-family: Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 0.95;
  }

  h2 em {
    color: #b85c38;
    font-style: italic;
  }

  .section-description {
    max-width: 380px;
    margin: 0;
    color: #777168;
    font-size: 1.25rem;
    line-height: 1.7;
  }

  /* =========================
     CARRUSEL
  ========================= */

  .products-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .products-window {
    width: 100%;
    overflow: hidden;
  }

  .products-track {
    display: flex;
    gap: 22px;
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .product-card {
    flex: 0 0 calc((100% - 66px) / 4);
    min-width: 0;
  }

  /* =========================
     IMAGEN
  ========================= */

  .product-image {
    position: relative;
    aspect-ratio: 0.82;
    overflow: hidden;
    background: #eee8dd;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-image img {
    transform: scale(1.04);
  }

  .best-seller {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 9px;
    background: #faf8f3;
    color: #252525;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .favorite {
    position: absolute;
    top: 12px;
    right: 12px;

    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;
    border-radius: 50%;

    background: rgba(250, 248, 243, 0.92);
    color: #252525;

    font-size: 1.35rem;
    cursor: pointer;

    transition:
      background 0.25s ease,
      color 0.25s ease;
  }

  .favorite:hover {
    background: #b85c38;
    color: #fff;
  }

  /* =========================
     INFORMACIÓN
  ========================= */

  .product-info {
    padding-top: 18px;
  }

  .product-category {
    display: block;
    margin-bottom: 7px;

    color: #918a80;

    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-info h3 {
    min-height: 44px;
    margin: 0;

    color: #252525;

    font-family: Georgia, serif;
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .product-price {
    margin-top: 10px;

    color: #252525;

    font-size: 1rem;
    font-weight: 700;
  }

  /* =========================
     LEYENDA
  ========================= */

  .cart-label {
    margin-top: 18px;
    margin-bottom: 9px;

    color: #777168;

    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* =========================
     SELECTOR CANTIDAD
  ========================= */

  .quantity-control {
    width: 100%;
    min-height: 44px;

    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;

    border: 1px solid #d8d0c4;
    background: #fff;

    overflow: hidden;
  }

  .quantity-button {
    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;
    background: transparent;

    color: #252525;

    font-size: 1.25rem;
    line-height: 1;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .quantity-button:hover {
    background: #252525;
    color: #fff;
  }

  .quantity {
    display: flex;
    align-items: center;
    justify-content: center;

    height: 44px;

    border-left: 1px solid #e5ded2;
    border-right: 1px solid #e5ded2;

    color: #252525;

    font-size: 0.9rem;
    font-weight: 700;
  }

  /* =========================
     FLECHAS
  ========================= */

  .carousel-button {
    flex: 0 0 42px;

    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #d8d0c4;
    background: #faf8f3;

    color: #252525;

    font-size: 1.2rem;

    cursor: pointer;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .carousel-button:hover:not(:disabled) {
    background: #252525;
    border-color: #252525;
    color: #fff;
  }

  .carousel-button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* =========================
     FOOTER CARRUSEL
  ========================= */

  .carousel-footer {
    display: flex;
    align-items: center;
    gap: 25px;

    margin-top: 35px;
  }

  .progress {
    flex: 1;
    height: 1px;
    background: #ddd5ca;
  }

  .progress-bar {
    width: 20%;
    height: 100%;
    background: #b85c38;
    transition: width 0.35s ease;
  }

  .product-counter {
    min-width: 70px;

    color: #777168;

    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: right;
  }

  /* =========================
     TABLET
  ========================= */

  @media (max-width: 1000px) {
    .product-card {
      flex-basis: calc((100% - 44px) / 3);
    }
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 600px) {
    .featured {
      padding: 70px 0;
    }

    .section-header {
      display: block;
      margin-bottom: 35px;
    }

    .section-description {
      margin-top: 22px;
    }

    .products-wrapper {
      gap: 8px;
    }

    .product-card {
      flex-basis: calc((100% - 22px) / 2);
    }

    .carousel-button {
      flex: 0 0 36px;
      width: 36px;
      height: 36px;
    }

    .products-track {
      gap: 22px;
    }

    .product-info h3 {
      font-size: 0.9rem;
    }

    .quantity-control {
      grid-template-columns: 38px 1fr 38px;
    }

    .quantity-button {
      width: 38px;
    }
  }

  @media (max-width: 430px) {
    .product-card {
      flex-basis: 100%;
    }
  }
</style>

<script>
  interface CartItem {
    id: number;
    name: string;
    price: number;
    quantity: number;
  }

  const STORAGE_KEY = "tekiti-cart";

  const track = document.querySelector<HTMLElement>("#products-track");
  const prevButton = document.querySelector<HTMLButtonElement>("#prev-products");
  const nextButton = document.querySelector<HTMLButtonElement>("#next-products");
  const counter = document.querySelector<HTMLElement>("#products-counter");
  const progress = document.querySelector<HTMLElement>("#products-progress");
  const quantityControls = document.querySelectorAll<HTMLElement>(".quantity-control");

  if (track && prevButton && nextButton && counter && progress) {

    /* =========================
       CARRITO DE COMPRAS
    ========================= */

    function getCart(): CartItem[] {
      try {
        const savedCart = localStorage.getItem(STORAGE_KEY);
        const parsedCart = savedCart ? JSON.parse(savedCart) : [];
        return Array.isArray(parsedCart) ? parsedCart : [];
      } catch (error) {
        console.error("Error al obtener el carrito:", error);
        return [];
      }
    }

    function saveCart(cart: CartItem[]) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
    }

    function getCartQuantity(productId: number): number {
      const cart = getCart();
      const item = cart.find((product) => Number(product.id) === Number(productId));
      return item ? Number(item.quantity) || 0 : 0;
    }

    function getTotalQuantity(): number {
      const cart = getCart();
      return cart.reduce((total, item) => total + Number(item.quantity || 0), 0);
    }

    function updateHeaderCounter() {
      const headerCounter = document.querySelector<HTMLElement>("#cart-count");
      if (!headerCounter) return;

      const total = getTotalQuantity();
      headerCounter.textContent = String(total);
      headerCounter.classList.toggle("visible", total > 0);
    }

    function updateProductQuantity(
      productName: string,
      price: number,
      quantity: number,
      productId: number
    ) {
      let cart = getCart();

      const existingItem = cart.find(
        (product) => Number(product.id) === Number(productId)
      );

      if (quantity <= 0) {
        cart = cart.filter(
          (product) => Number(product.id) !== Number(productId)
        );
      } else if (existingItem) {
        existingItem.quantity = quantity;
      } else {
        cart.push({
          id: Number(productId),
          name: productName,
          price: Number(price),
          quantity,
        });
      }

      saveCart(cart);
      updateHeaderCounter();

      // Disparar evento para avisarle a las demás secciones / drawer que el carrito cambió
      window.dispatchEvent(
        new StorageEvent("storage", {
          key: STORAGE_KEY,
          newValue: JSON.stringify(cart),
        })
      );
      window.dispatchEvent(new CustomEvent("tekiti-cart-updated"));
    }

    /* =========================
       CONTROLES DE CANTIDAD
    ========================= */

    quantityControls.forEach((control) => {
      const productName = control.dataset.product || "";
      const price = Number(control.dataset.price || 0);
      const productId = Number(control.dataset.id || 0);

      const quantityElement = control.querySelector<HTMLElement>(".quantity");
      const decreaseButton = control.querySelector<HTMLButtonElement>(".decrease");
      const increaseButton = control.querySelector<HTMLButtonElement>(".increase");

      if (!quantityElement || !decreaseButton || !increaseButton) return;

      function refreshQuantity() {
        const currentQuantity = getCartQuantity(productId);
        quantityElement.textContent = String(currentQuantity);
      }

      refreshQuantity();

      // Botón Disminuir
      decreaseButton.addEventListener("click", () => {
        const currentQuantity = getCartQuantity(productId);
        const newQuantity = Math.max(0, currentQuantity - 1);

        updateProductQuantity(productName, price, newQuantity, productId);
        refreshQuantity();
      });

      // Botón Aumentar
      increaseButton.addEventListener("click", () => {
        const currentQuantity = getCartQuantity(productId);
        const newQuantity = currentQuantity + 1;

        updateProductQuantity(productName, price, newQuantity, productId);
        refreshQuantity();
      });
    });

    // Escuchar cambios para sincronizar la UI si se cambia la cantidad en el carrito lateral
    window.addEventListener("tekiti-cart-updated", () => {
      quantityControls.forEach((control) => {
        const productId = Number(control.dataset.id || 0);
        const quantityElement = control.querySelector<HTMLElement>(".quantity");

        if (quantityElement) {
          quantityElement.textContent = String(getCartQuantity(productId));
        }
      });

      updateHeaderCounter();
    });

    window.addEventListener("storage", (event) => {
      if (event.key === STORAGE_KEY) {
        window.dispatchEvent(new CustomEvent("tekiti-cart-updated"));
      }
    });

    updateHeaderCounter();

    /* =========================
       CARRUSEL
    ========================= */

    let currentPosition = 0;

    function getVisibleProducts() {
      if (window.innerWidth <= 600) return 1;
      if (window.innerWidth <= 1000) return 3;
      return 4;
    }

    function getCardWidth() {
      const firstCard = track.querySelector<HTMLElement>(".product-card");
      if (!firstCard) return 0;

      const styles = window.getComputedStyle(track);
      const gap =
        parseFloat(styles.columnGap) ||
        parseFloat(styles.gap) ||
        0;

      return firstCard.offsetWidth + gap;
    }

    function productsCount() {
      return track.querySelectorAll(".product-card").length;
    }

    function updateCarousel() {
      const visibleProducts = getVisibleProducts();
      const totalProducts = productsCount();

      const maxPosition = Math.max(0, totalProducts - visibleProducts);

      currentPosition = Math.min(currentPosition, maxPosition);

      const offset = currentPosition * getCardWidth();

      track.style.transform = `translateX(-${offset}px)`;

      prevButton.disabled = currentPosition === 0;
      nextButton.disabled = currentPosition >= maxPosition;

      const first = totalProducts === 0 ? 0 : currentPosition + 1;
      const last = Math.min(currentPosition + visibleProducts, totalProducts);

      counter.textContent = `${String(first).padStart(2, "0")} — ${String(last).padStart(2, "0")}`;

      const progressPercentage =
        maxPosition === 0
          ? totalProducts > 0 ? 100 : 0
          : ((currentPosition + 1) / (maxPosition + 1)) * 100;

      progress.style.width = `${progressPercentage}%`;
    }

    prevButton.addEventListener("click", () => {
      if (currentPosition > 0) {
        currentPosition--;
        updateCarousel();
      }
    });

    nextButton.addEventListener("click", () => {
      const visibleProducts = getVisibleProducts();
      const maxPosition = Math.max(0, productsCount() - visibleProducts);

      if (currentPosition < maxPosition) {
        currentPosition++;
        updateCarousel();
      }
    });

    window.addEventListener("resize", updateCarousel);
    updateCarousel();
  }
</script>