---

<section class="featured" id="destacados">

  <div class="container">

    <!-- ENCABEZADO -->

    <div class="section-header">

      <div>
        <span class="eyebrow">SELECCIÓN TEKITI</span>

        <h2>
          Los favoritos de nuestra comunidad
        </h2>
      </div>

      <a href="#productos" class="view-all">
        Ver todos
        <span>→</span>
      </a>

    </div>


    <!-- CARRUSEL -->

    <div class="carousel-wrapper">

      <button
        class="carousel-arrow carousel-arrow-left"
        id="prevProducts"
        aria-label="Productos anteriores"
      >
        ←
      </button>

      <div class="carousel">

        <div class="products-track" id="productsTrack">

          {products.map((product) => (

            <article class="product-card">

              <div class="product-image">

                <img
                  src={product.image}
                  alt={product.name}
                  loading="lazy"
                />

                <span class="badge">
                  MÁS VENDIDO
                </span>

                <button
                  class="favorite"
                  aria-label={`Añadir ${product.name} a favoritos`}
                >
                  ♡
                </button>

                <button class="add-cart">
                  Añadir al carrito
                </button>

              </div>

              <div class="product-info">

                <span class="product-category">
                  {product.category}
                </span>

                <h3>
                  {product.name}
                </h3>

                <span class="price">
                  {product.price}
                </span>

              </div>

            </article>

          ))}

        </div>

      </div>


      <button
        class="carousel-arrow carousel-arrow-right"
        id="nextProducts"
        aria-label="Siguientes productos"
      >
        →
      </button>

    </div>


    <!-- INDICADORES -->

    <div class="carousel-footer">

      <div class="carousel-progress">
        <div class="carousel-progress-bar" id="progressBar"></div>
      </div>

      <span class="product-counter" id="productCounter">
        01 — 20
      </span>

    </div>

  </div>

</section>


<script>
  const track = document.querySelector<HTMLElement>("#productsTrack");
  const nextButton =
    document.querySelector<HTMLButtonElement>("#nextProducts");
  const prevButton =
    document.querySelector<HTMLButtonElement>("#prevProducts");

  const progressBar =
    document.querySelector<HTMLElement>("#progressBar");

  const productCounter =
    document.querySelector<HTMLElement>("#productCounter");

  const cards =
    document.querySelectorAll<HTMLElement>(".product-card");

  let currentPosition = 0;

  function getVisibleProducts() {
    if (window.innerWidth <= 600) {
      return 2;
    }

    if (window.innerWidth <= 1000) {
      return 3;
    }

    return 4;
  }

  function updateCarousel() {

    if (!track || cards.length === 0) return;

    const visibleProducts = getVisibleProducts();

    const maxPosition =
      Math.max(0, cards.length - visibleProducts);

    currentPosition = Math.min(
      currentPosition,
      maxPosition
    );

    const cardWidth = cards[0].getBoundingClientRect().width;

    const gap = parseFloat(
      getComputedStyle(track).gap
    );

    const movement =
      currentPosition * (cardWidth + gap);

    track.style.transform =
      `translateX(-${movement}px)`;

    /*
     * Flechas
     */

    if (prevButton) {
      prevButton.disabled =
        currentPosition === 0;
    }

    if (nextButton) {
      nextButton.disabled =
        currentPosition >= maxPosition;
    }

    /*
     * Contador
     */

    const firstProduct =
      currentPosition + 1;

    const lastVisible =
      Math.min(
        currentPosition + visibleProducts,
        cards.length
      );

    if (productCounter) {
      productCounter.textContent =
        `${String(firstProduct).padStart(2, "0")} — ${String(lastVisible).padStart(2, "0")}`;
    }

    /*
     * Barra de progreso
     */

    if (progressBar) {

      const progress =
        maxPosition === 0
          ? 100
          : (currentPosition / maxPosition) * 100;

      progressBar.style.width =
        `${Math.max(progress, 8)}%`;
    }
  }


  /*
   * SIGUIENTE
   */

  nextButton?.addEventListener("click", () => {

    const visibleProducts =
      getVisibleProducts();

    const maxPosition =
      cards.length - visibleProducts;

    if (currentPosition < maxPosition) {
      currentPosition++;
      updateCarousel();
    }

  });


  /*
   * ANTERIOR
   */

  prevButton?.addEventListener("click", () => {

    if (currentPosition > 0) {
      currentPosition--;
      updateCarousel();
    }

  });


  /*
   * RESPONSIVE
   */

  window.addEventListener("resize", () => {
    updateCarousel();
  });


  /*
   * INICIALIZAR
   */

  updateCarousel();
</script>


<style>

  /* =========================
     SECCIÓN
  ========================= */

  .featured {
    padding: 110px 0;

    background: #faf8f3;
  }

  .container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }


  /* =========================
     ENCABEZADO
  ========================= */

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    margin-bottom: 48px;
  }

  .eyebrow {
    display: block;

    margin-bottom: 15px;

    color: #b85c38;

    font-size: 0.7rem;
    font-weight: 700;

    letter-spacing: 0.2em;
  }

  h2 {
    max-width: 600px;

    margin: 0;

    color: #252525;

    font-family: Georgia, "Times New Roman", serif;

    font-size: clamp(2.3rem, 4vw, 3.6rem);

    font-weight: 400;

    line-height: 1.05;
  }

  .view-all {
    display: flex;
    align-items: center;
    gap: 12px;

    color: #252525;

    text-decoration: none;

    font-size: 0.85rem;
    font-weight: 600;

    border-bottom: 1px solid #252525;

    padding-bottom: 6px;
  }

  .view-all span {
    transition: transform 0.25s ease;
  }

  .view-all:hover {
    color: #b85c38;

    border-color: #b85c38;
  }

  .view-all:hover span {
    transform: translateX(5px);
  }


  /* =========================
     CARRUSEL
  ========================= */

  .carousel-wrapper {
    position: relative;
  }

  .carousel {
    width: 100%;

    overflow: hidden;
  }

  .products-track {
    display: flex;

    gap: 24px;

    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);

    will-change: transform;
  }


  /* =========================
     PRODUCTO
  ========================= */

  .product-card {
    flex: 0 0 calc((100% - 72px) / 4);

    min-width: 0;
  }


  /* =========================
     IMAGEN
  ========================= */

  .product-image {
    position: relative;

    overflow: hidden;

    aspect-ratio: 4 / 5;

    background: #eee8de;
  }

  .product-image img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.6s ease;
  }

  .product-card:hover .product-image img {
    transform: scale(1.05);
  }


  /* =========================
     ETIQUETA
  ========================= */

  .badge {
    position: absolute;

    top: 15px;
    left: 15px;

    padding: 7px 10px;

    background: #252525;

    color: #fff;

    font-size: 0.62rem;
    font-weight: 700;

    letter-spacing: 0.08em;
  }


  /* =========================
     FAVORITOS
  ========================= */

  .favorite {
    position: absolute;

    top: 14px;
    right: 14px;

    width: 38px;
    height: 38px;

    border: none;

    border-radius: 50%;

    background: rgba(250, 248, 243, 0.92);

    color: #252525;

    font-size: 1.3rem;

    cursor: pointer;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .favorite:hover {
    background: #fff;

    color: #b85c38;

    transform: scale(1.08);
  }


  /* =========================
     CARRITO
  ========================= */

  .add-cart {
    position: absolute;

    left: 12px;
    right: 12px;
    bottom: 12px;

    width: calc(100% - 24px);

    padding: 13px;

    border: none;

    background: #faf8f3;

    color: #252525;

    font-size: 0.8rem;
    font-weight: 600;

    cursor: pointer;

    opacity: 0;

    transform: translateY(10px);

    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      background 0.25s ease;
  }

  .product-card:hover .add-cart {
    opacity: 1;

    transform: translateY(0);
  }

  .add-cart:hover {
    background: #b85c38;

    color: #fff;
  }


  /* =========================
     INFORMACIÓN
  ========================= */

  .product-info {
    padding-top: 18px;
  }

  .product-category {
    display: block;

    margin-bottom: 7px;

    color: #8a837a;

    font-size: 0.68rem;
    font-weight: 600;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }

  .product-info h3 {
    margin: 0 0 9px;

    color: #252525;

    font-family: Georgia, "Times New Roman", serif;

    font-size: 1.25rem;
    font-weight: 400;

    line-height: 1.2;
  }

  .price {
    color: #252525;

    font-size: 0.9rem;
    font-weight: 600;
  }


  /* =========================
     FLECHAS
  ========================= */

  .carousel-arrow {
    position: absolute;

    top: 38%;

    z-index: 5;

    width: 48px;
    height: 48px;

    border: 1px solid #d8d0c4;

    border-radius: 50%;

    background: #faf8f3;

    color: #252525;

    font-size: 1.1rem;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease,
      opacity 0.25s ease;
  }

  .carousel-arrow:hover:not(:disabled) {
    background: #b85c38;

    color: #fff;

    transform: scale(1.08);
  }

  .carousel-arrow:disabled {
    opacity: 0.3;

    cursor: not-allowed;
  }

  .carousel-arrow-left {
    left: -24px;
  }

  .carousel-arrow-right {
    right: -24px;
  }


  /* =========================
     FOOTER DEL CARRUSEL
  ========================= */

  .carousel-footer {
    display: flex;
    align-items: center;
    gap: 25px;

    margin-top: 45px;
  }

  .carousel-progress {
    flex: 1;

    height: 2px;

    background: #ded7cd;

    overflow: hidden;
  }

  .carousel-progress-bar {
    width: 8%;
    height: 100%;

    background: #252525;

    transition: width 0.45s ease;
  }

  .product-counter {
    color: #777067;

    font-size: 0.72rem;

    letter-spacing: 0.1em;

    white-space: nowrap;
  }


  /* =========================
     TABLET
  ========================= */

  @media (max-width: 1000px) {

    .product-card {
      flex: 0 0 calc((100% - 48px) / 3);
    }

    .carousel-arrow-left {
      left: -15px;
    }

    .carousel-arrow-right {
      right: -15px;
    }

  }


  /* =========================
     MÓVIL
  ========================= */

  @media (max-width: 600px) {

    .featured {
      padding: 75px 0;
    }

    .section-header {
      align-items: flex-start;

      flex-direction: column;

      gap: 25px;

      margin-bottom: 35px;
    }

    h2 {
      font-size: 2.4rem;
    }

    .products-track {
      gap: 12px;
    }

    .product-card {
      flex: 0 0 calc((100% - 12px) / 2);
    }

    .product-image {
      aspect-ratio: 3 / 4;
    }

    .badge {
      top: 9px;
      left: 9px;

      padding: 5px 7px;

      font-size: 0.52rem;
    }

    .favorite {
      top: 8px;
      right: 8px;

      width: 32px;
      height: 32px;

      font-size: 1.1rem;
    }

    .add-cart {
      display: none;
    }

    .product-info {
      padding-top: 13px;
    }

    .product-info h3 {
      font-size: 1rem;
    }

    .product-category {
      font-size: 0.58rem;
    }

    .price {
      font-size: 0.8rem;
    }

    .carousel-arrow {
      width: 40px;
      height: 40px;

      top: 34%;
    }

    .carousel-arrow-left {
      left: -10px;
    }

    .carousel-arrow-right {
      right: -10px;
    }

    .carousel-footer {
      margin-top: 35px;
    }

  }

</style>
