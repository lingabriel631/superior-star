---
// src/components/NewArrivals.astro
const API_URL = import.meta.env.PUBLIC_API_URL || "https://superior-star.onrender.com";

let newProducts: any[] = [];

try {
  const response = await fetch(`${API_URL}/api/products`);
  if (response.ok) {
    const result = await response.json();
    const activeProducts = result.success && Array.isArray(result.data)
      ? result.data.filter((product: any) => product.isActive)
      : [];

    const flaggedNew = activeProducts.filter((product: any) => Boolean(product.isNew));
    newProducts = flaggedNew.length > 0 ? flaggedNew : activeProducts.slice(-4).reverse();
  }
} catch (error) {
  console.error("Error al cargar novedades:", error);
}

const formatPrice = (price: number) =>
  new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
  }).format(Number(price || 0));
---

<section class="new-arrivals" id="novedades" aria-label="Novedades de Costa Azul">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow">RECIÉN LLEGADOS • COSTA AZUL</span>
        <h2>
          Nuevas <em>piezas</em>
        </h2>
      </div>

      <p class="section-description">
        Creaciones recientes que se suman a la tienda, elaboradas con el detalle y la calidez de nuestra costa.
      </p>
    </div>

    {newProducts.length === 0 ? (
      <p class="empty-state">Próximamente incorporaremos nuevas piezas a la colección.</p>
    ) : (
      <div class="products-grid">
        {newProducts.map((product) => (
          <article class="product-card">
            <div class="product-image">
              <a href={`/products/${product.slug}`}>
                <img
                  src={product.image || "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=900&q=80"}
                  alt={product.name}
                  loading="lazy"
                />
              </a>
              <span class="badge">NOVEDAD</span>
            </div>

            <div class="product-info">
              <span class="product-category">
                {product.category?.name || product.category || "Artesanía"}
              </span>

              <h3>
                <a href={`/products/${product.slug}`} class="product-title">
                  {product.name}
                </a>
              </h3>

              <div class="product-footer">
                <span class="product-price">{formatPrice(product.price)}</span>
                <a href={`/products/${product.slug}`} class="pill-btn">
                  Ver detalle
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .new-arrivals {
    padding: 90px 0;
    background: #FAF8F5;
  }

  .container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 48px;
  }

  .eyebrow {
    display: block;
    margin-bottom: 10px;
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .section-header h2 {
    margin: 0;
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .section-header h2 em {
    font-style: italic;
    font-weight: 600;
  }

  .section-description {
    max-width: 380px;
    margin: 0;
    color: #5A6577;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  .product-card {
    background: #FFFFFF;
    border: 1px solid #E7DCC8;
    border-radius: 16px;
    padding: 14px;
    box-shadow: 0 4px 14px rgba(0, 43, 92, 0.04);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 43, 92, 0.09);
  }

  .product-image {
    position: relative;
    aspect-ratio: 0.85;
    border-radius: 12px;
    overflow: hidden;
    background: #E7DCC8;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .product-card:hover .product-image img {
    transform: scale(1.04);
  }

  .badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 12px;
    border-radius: 999px;
    background: #002B5C;
    color: #E7DCC8;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .product-info {
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-category {
    margin-bottom: 6px;
    color: #64748B;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-info h3 {
    margin: 0 0 14px;
    min-height: 42px;
  }

  .product-title {
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.98rem;
    font-weight: 700;
    text-decoration: none;
    line-height: 1.35;
  }

  .product-title:hover {
    text-decoration: underline;
  }

  .product-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .product-price {
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
  }

  .pill-btn {
    padding: 8px 16px;
    border-radius: 999px;
    background: #002B5C;
    color: #FFFFFF;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .pill-btn:hover {
    background: #001d40;
    transform: translateY(-1px);
  }

  .empty-state {
    color: #5A6577;
    font-size: 0.95rem;
  }

  @media (max-width: 1000px) {
    .products-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .new-arrivals {
      padding: 70px 0;
    }

    .section-header {
      display: block;
      margin-bottom: 32px;
    }

    .section-description {
      margin-top: 14px;
    }

    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>