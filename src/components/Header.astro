---
let categories = [];

try {
  const API_URL = import.meta.env.PUBLIC_API_URL || "https://superior-star.onrender.com";
  const res = await fetch(`${API_URL}/api/categories`);
  const result = await res.json();
  if (result.success && Array.isArray(result.data)) {
    categories = result.data;
  }
} catch (err) {
  console.error("Error al cargar categorías en el menú:", err);
}
---

<header class="header">
  <div class="container">

    <!-- LOGO CON ISOTIPO -->
    <a href="/" class="logo">
      <svg width="42" height="42" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="32" cy="23" r="10" fill="#E7DCC8" />
        <path d="M32 7V11M18 13L21 16M46 13L43 16M13 24H17M47 24H51" stroke="#E7DCC8" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M12 35C20 25 34 25 42 35C36 31 26 31 20 37C28 37 38 41 52 35C44 45 22 47 12 35Z" fill="#002B5C"/>
        <path d="M32 37V53M23 47C23 52 41 52 41 47" stroke="#002B5C" stroke-width="3.2" stroke-linecap="round"/>
      </svg>
      <div class="logo-text">
        <span class="logo-name">COSTA AZUL</span>
        <span class="logo-tagline">Artesanías y Estilo de la Costa Salvadoreña</span>
      </div>
    </a>

    <!-- NAVEGACIÓN -->
    <nav class="navigation" aria-label="Navegación principal">
      <a href="/" class="nav-link active">Inicio</a>

      <div class="categories-menu">
        <button
          type="button"
          class="nav-link categories-button"
          aria-expanded="false"
          aria-controls="categories-dropdown"
        >
          <span>Productos</span>
          <span class="arrow">⌄</span>
        </button>

        <div id="categories-dropdown" class="categories-dropdown">
          <a href="#productos" class="category-item">
            <span>✨ Ver Todo</span>
          </a>
          {categories.map((cat: any) => (
            <a href={`/categorias/${cat.slug}`} class="category-item">
              <span>{cat.name}</span>
            </a>
          ))}
        </div>
      </div>

      <a href="#ofertas" class="nav-link">Ofertas</a>
    </nav>

    <!-- ACCIONES -->
    <div class="actions">
      <a href="#" class="cart-action" aria-label="Abrir Carrito">
        <span class="icon">🛒</span>
        <span class="action-text">Carrito</span>
        <span id="cart-count" class="cart-count">0</span>
      </a>

      <a href="/cuenta" class="btn-account" aria-label="Cuenta">
        Cuenta
      </a>

      <button type="button" class="menu-button" aria-label="Abrir menú">☰</button>
    </div>

  </div>
</header>

<script>
  const categoriesButton = document.querySelector(".categories-button");
  const categoriesMenu = document.querySelector(".categories-menu");

  if (categoriesButton && categoriesMenu) {
    categoriesButton.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = categoriesMenu.classList.toggle("is-open");
      categoriesButton.setAttribute("aria-expanded", String(isOpen));
    });

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !categoriesMenu.contains(event.target)) {
        categoriesMenu.classList.remove("is-open");
        categoriesButton.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #FFFFFF;
    border-bottom: 1px solid #E7DCC8;
    box-shadow: 0 2px 12px rgba(0, 43, 92, 0.04);
  }

  .container {
    width: min(1200px, 92%);
    min-height: 80px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.45rem;
    font-weight: 800;
    color: #002B5C;
    letter-spacing: 0.06em;
    line-height: 1.05;
  }

  .logo-tagline {
    margin-top: 3px;
    color: #64748B;
    font-size: 0.65rem;
    font-weight: 500;
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* BOTONES DE NAVEGACIÓN ESTILO PÍLDORA */
  .nav-link {
    padding: 8px 18px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #002B5C;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .nav-link:hover,
  .nav-link.active {
    background: #002B5C;
    color: #FFFFFF;
  }

  .categories-menu {
    position: static;
  }

  .categories-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    padding: 16px 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    background: #FAF8F5;
    border-top: 2px solid #002B5C;
    border-bottom: 1px solid #E7DCC8;
    box-shadow: 0 12px 24px rgba(0, 43, 92, 0.08);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition: all 0.2s ease;
    z-index: 999;
  }

  .categories-menu.is-open .categories-dropdown,
  .categories-menu:hover .categories-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .category-item {
    padding: 9px 18px;
    border-radius: 999px;
    background: #FFFFFF;
    border: 1px solid #E7DCC8;
    color: #002B5C;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .category-item:hover {
    background: #002B5C;
    color: #FFFFFF;
    border-color: #002B5C;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cart-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 8px;
    background: #E7DCC8;
    color: #002B5C;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cart-action:hover {
    background: #dcd0b9;
  }

  .cart-count {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: #002B5C;
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .cart-count.visible {
    display: inline-flex;
  }

  .btn-account {
    padding: 8px 18px;
    border-radius: 8px;
    background: #002B5C;
    color: #FFFFFF;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .btn-account:hover {
    background: #001d40;
  }

  .menu-button {
    display: none;
    border: none;
    background: transparent;
    color: #002B5C;
    font-size: 1.6rem;
    cursor: pointer;
  }

  @media (max-width: 850px) {
    .navigation, .action-text, .btn-account { display: none; }
    .menu-button { display: block; }
  }
</style>