---
// src/components/Header.astro
---

<header class="header">
  <div class="container">

    <!-- LOGO COSTA AZUL -->
    <a href="#inicio" class="logo" aria-label="Costa Azul Inicio">
      <!-- Si prefieres usar tu imagen guardada en public/images/, cambia el <svg> por:
      <img src="/images/logo-costa-azul.png" alt="Costa Azul" class="logo-img" /> -->
      <svg class="logo-svg" viewBox="0 0 120 110" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Rayos del sol -->
        <polygon points="56,4 52,18 60,18" fill="#D4B07A" />
        <polygon points="38,9 40,23 47,20" fill="#D4B07A" />
        <polygon points="23,21 31,32 36,27" fill="#D4B07A" />
        <polygon points="14,38 27,44 29,37" fill="#D4B07A" />
        <polygon points="13,57 27,57 26,50" fill="#D4B07A" />
        <polygon points="74,9 65,20 72,23" fill="#D4B07A" />
        <polygon points="88,21 76,27 81,32" fill="#D4B07A" />
        <!-- Arco solar -->
        <path d="M33 54C33 40.5 43.5 30 56.5 30C66 30 74.2 35.5 78 43.5" stroke="#D4B07A" stroke-width="5.5" stroke-linecap="round" />
        <!-- Ola principal en Azul Marino -->
        <path d="M14 68C32 54 54 64 72 68C86 71 98 65 104 58C97 73 82 78 65 74C46 69 30 61 14 68Z" fill="#002B5C" />
        <path d="M58 48C64 36 82 34 90 46C96 55 93 66 84 69C88 61 86 52 79 49C73 46 67 50 66 56C63 52 60 50 58 48Z" fill="#002B5C" />
        <!-- Ola arena inferior -->
        <path d="M16 74C30 68 44 72 56 76C43 76 29 73 16 74Z" fill="#D4B07A" />
        <!-- Ancla en Azul Marino -->
        <path d="M60 73V98" stroke="#002B5C" stroke-width="6" stroke-linecap="round" />
        <path d="M38 84C42 97 52 102 60 105C68 102 78 97 82 84" stroke="#002B5C" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
        <!-- Puntas del ancla -->
        <polygon points="36,78 32,89 44,86" fill="#002B5C" />
        <polygon points="84,78 76,86 88,89" fill="#002B5C" />
      </svg>

      <div class="logo-text">
        <span class="logo-name">COSTA AZUL</span>
        <span class="logo-tagline">Artesanías y Estilo de la Costa</span>
      </div>
    </a>

    <!-- NAVEGACIÓN (SIN FLECHAS, APUNTANDO A SECCIONES DEL INDEX) -->
    <nav class="navigation" id="main-nav" aria-label="Navegación principal">
      <a href="#inicio" class="nav-link active">Inicio</a>
      <a href="#novedades" class="nav-link">Novedades</a>
      <a href="#ofertas" class="nav-link">Ofertas</a>
      <a href="#categorias" class="nav-link">Categorías</a>
    </nav>

    <!-- ACCIONES -->
    <div class="actions">
      <a href="#" class="cart-action" aria-label="Abrir Carrito">
        <span class="icon">🛒</span>
        <span class="action-text">Carrito</span>
        <span id="cart-count" class="cart-count">0</span>
      </a>

      <a href="/cuenta" class="btn-account" aria-label="Cuenta">
        Cuenta
      </a>

      <button type="button" class="menu-button" id="mobile-menu-btn" aria-label="Abrir menú">
        ☰
      </button>
    </div>

  </div>
</header>

<script>
  // Resaltar enlace activo al hacer clic y cerrar menú móvil
  const navLinks = document.querySelectorAll(".nav-link");
  const navMenu = document.querySelector("#main-nav");
  const mobileBtn = document.querySelector("#mobile-menu-btn");

  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      navLinks.forEach((l) => l.classList.remove("active"));
      link.classList.add("active");
      navMenu?.classList.remove("is-open");
    });
  });

  mobileBtn?.addEventListener("click", () => {
    navMenu?.classList.toggle("is-open");
  });
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #FFFFFF;
    border-bottom: 1px solid #E7DCC8;
    box-shadow: 0 2px 12px rgba(0, 43, 92, 0.04);
  }

  .container {
    width: min(1200px, 92%);
    min-height: 82px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* LOGO */
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo-svg,
  .logo-img {
    width: 48px;
    height: 44px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
    color: #002B5C;
    letter-spacing: 0.06em;
    line-height: 1.05;
  }

  .logo-tagline {
    margin-top: 3px;
    color: #64748B;
    font-size: 0.65rem;
    font-weight: 500;
  }

  /* NAVEGACIÓN */
  .navigation {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-link {
    padding: 8px 18px;
    border-radius: 999px;
    background: transparent;
    color: #002B5C;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    background: #002B5C;
    color: #FFFFFF;
  }

  /* ACCIONES */
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cart-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: #E7DCC8;
    color: #002B5C;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .cart-action:hover {
    background: #dcd0b9;
  }

  .cart-count {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: #002B5C;
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .cart-count.visible {
    display: inline-flex;
  }

  .btn-account {
    padding: 8px 20px;
    border-radius: 999px;
    background: #002B5C;
    color: #FFFFFF;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .btn-account:hover {
    background: #001d40;
  }

  .menu-button {
    display: none;
    border: none;
    background: transparent;
    color: #002B5C;
    font-size: 1.6rem;
    cursor: pointer;
  }

  @media (max-width: 850px) {
    .navigation {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      flex-direction: column;
      background: #FFFFFF;
      padding: 16px;
      border-bottom: 1px solid #E7DCC8;
      box-shadow: 0 10px 20px rgba(0, 43, 92, 0.08);
    }

    .navigation.is-open {
      display: flex;
    }

    .nav-link {
      width: 100%;
      text-align: center;
    }

    .action-text,
    .btn-account {
      display: none;
    }

    .menu-button {
      display: block;
    }
  }
</style>