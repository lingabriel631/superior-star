---
---

<section class="offers" id="ofertas">
  <div class="offers-container">

    <div class="section-header">
      <div>
        <span class="eyebrow">
          OFERTAS TEKITI
        </span>

        <h2>
          Piezas con
          <em>descuento</em>
        </h2>
      </div>

      <p class="section-description">
        Descubre piezas artesanales seleccionadas
        con precios especiales por tiempo limitado.
      </p>
    </div>


    <div class="offers-wrapper">

      <button
        class="carousel-button carousel-prev"
        id="prev-offers"
        type="button"
        aria-label="Ofertas anteriores"
      >
        ←
      </button>


      <div class="offers-window">

        <div
          class="offers-track"
          id="offers-track"
        >
        </div>

      </div>


      <button
        class="carousel-button carousel-next"
        id="next-offers"
        type="button"
        aria-label="Siguientes ofertas"
      >
        →
      </button>

    </div>


    <div class="carousel-footer">

      <div class="progress">
        <div
          class="progress-bar"
          id="offers-progress"
        ></div>
      </div>

      <div
        class="offer-counter"
        id="offers-counter"
      >
        00 — 00
      </div>

    </div>

  </div>
</section>


<style is:global>

  /* ========================================
     SECCIÓN
  ======================================== */

  .offers {
    padding: 100px 0;
    background: #f3ede2;
  }


  .offers-container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }


  /* ========================================
     ENCABEZADO
  ======================================== */

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 50px;
    margin-bottom: 55px;
  }


  .eyebrow {
    display: block;
    margin-bottom: 14px;
    color: #b85c38;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }


  .section-header h2 {
    margin: 0;
    color: #252525;
    font-family: Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 0.95;
  }


  .section-header h2 em {
    color: #b85c38;
    font-style: italic;
  }


  .section-description {
    max-width: 380px;
    margin: 0;
    color: #777168;
    font-size: 0.95rem;
    line-height: 1.7;
  }


  /* ========================================
     CARRUSEL
  ======================================== */

  .offers-wrapper {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 18px;
  }


  /*
    IMPORTANTE:
    flex: 1 + min-width: 0 evita que
    el carrusel se salga del contenedor
    por culpa de las flechas.
  */

  .offers-window {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }


  .offers-track {
    display: flex;
    gap: 22px;
    width: 100%;
    transition: transform 0.45s
      cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }


  .offer-card {
    flex: 0 0
      calc((100% - 66px) / 4);
    width: calc((100% - 66px) / 4);
    min-width: 0;
    max-width: calc((100% - 66px) / 4);
  }


  /* ========================================
     IMAGEN
  ======================================== */

  .offer-image {
    position: relative;
    width: 100%;
    aspect-ratio: 0.82;
    overflow: hidden;
    background: #e5ded2;
  }


  .offer-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }


  .offer-card:hover .offer-image img {
    transform: scale(1.04);
  }


  /* ========================================
     DESCUENTO
  ======================================== */

  .discount-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;

    padding: 7px 10px;

    background: #b85c38;
    color: #fff;

    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }


  /* ========================================
     FAVORITOS
  ======================================== */

  .favorite {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;

    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;
    border-radius: 50%;

    background: rgba(250, 248, 243, 0.92);
    color: #252525;

    font-size: 1.35rem;

    cursor: pointer;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }


  .favorite:hover {
    background: #b85c38;
    color: #fff;
    transform: scale(1.05);
  }


  /* ========================================
     INFORMACIÓN
  ======================================== */

  .offer-info {
    padding-top: 18px;
  }


  .offer-category {
    display: block;
    margin-bottom: 7px;

    color: #918a80;

    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }


  .offer-info h3 {
    min-height: 44px;

    margin: 0;

    color: #252525;

    font-family: Georgia, serif;
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.35;
  }


  /* ========================================
     PRECIOS
  ======================================== */

  .prices {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 10px;

    margin-top: 10px;
  }


  .old-price {
    color: #9b948b;

    font-size: 0.82rem;

    text-decoration: line-through;
  }


  .offer-price {
    color: #b85c38;

    font-size: 1.05rem;
    font-weight: 700;
  }


  /* ========================================
     CARRITO
  ======================================== */

  .cart-label {
    margin-top: 18px;
    margin-bottom: 9px;

    color: #777168;

    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  .quantity-control {
    width: 100%;
    min-height: 44px;

    display: grid;

    grid-template-columns:
      44px
      minmax(0, 1fr)
      44px;

    align-items: center;

    border: 1px solid #d8d0c4;

    background: #fff;

    overflow: hidden;
  }


  .quantity-button {
    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;

    background: transparent;

    color: #252525;

    font-size: 1.25rem;
    line-height: 1;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }


  .quantity-button:hover {
    background: #252525;
    color: #fff;
  }


  .quantity {
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-left: 1px solid #e5ded2;
    border-right: 1px solid #e5ded2;

    color: #252525;

    font-size: 0.9rem;
    font-weight: 700;
  }


  /* ========================================
     FLECHAS
  ======================================== */

  .carousel-button {
    flex: 0 0 42px;

    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #d8d0c4;

    background: #f3ede2;

    color: #252525;

    font-size: 1.2rem;

    cursor: pointer;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }


  .carousel-button:hover:not(:disabled) {
    background: #252525;
    border-color: #252525;
    color: #fff;
  }


  .carousel-button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }


  /* ========================================
     PIE
  ======================================== */

  .carousel-footer {
    display: flex;
    align-items: center;

    gap: 25px;

    margin-top: 35px;
  }


  .progress {
    flex: 1;

    height: 1px;

    background: #d8d0c4;
  }


  .progress-bar {
    width: 0%;
    height: 100%;

    background: #b85c38;

    transition:
      width 0.35s ease;
  }


  .offer-counter {
    min-width: 70px;

    color: #777168;

    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;

    text-align: right;
  }


  /* ========================================
     TABLET
  ======================================== */

  @media (max-width: 1000px) {

    .offer-card {
      flex-basis:
        calc((100% - 44px) / 3);
    }

  }


  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 600px) {

    .offers {
      padding: 70px 0;
    }


    .offers-container {
      width: min(92%, 520px);
    }


    .section-header {
      display: block;
      margin-bottom: 35px;
    }


    .section-header h2 {
      font-size: clamp(
        2.3rem,
        10vw,
        3rem
      );
    }


    .section-description {
      margin-top: 22px;
    }


    .offers-wrapper {
      gap: 8px;
    }


    .offer-card {
      flex-basis:
        calc((100% - 22px) / 2);
    }


    .offers-track {
      gap: 22px;
    }


    .carousel-button {
      flex: 0 0 36px;

      width: 36px;
      height: 36px;
    }


    .offer-info h3 {
      font-size: 0.9rem;
    }


    .quantity-control {
      grid-template-columns:
        38px
        minmax(0, 1fr)
        38px;
    }


    .quantity-button {
      width: 38px;
    }

  }


  /* ========================================
     TELÉFONOS PEQUEÑOS
  ======================================== */

  @media (max-width: 430px) {

    .offer-card {
      flex-basis: 100%;
    }


    .section-description {
      font-size: 0.88rem;
    }


    .offers-wrapper {
      gap: 6px;
    }


    .offers-track {
      gap: 18px;
    }

  }

</style>


<script>

  const STORAGE_KEY = "tekiti-cart";

  const track =
    document.querySelector("#offers-track");

  const prevButton =
    document.querySelector("#prev-offers");

  const nextButton =
    document.querySelector("#next-offers");

  const counter =
    document.querySelector("#offers-counter");

  const progress =
    document.querySelector("#offers-progress");

  let cart = [];

  let currentPosition = 0;


  /* ========================================
     CARRITO
  ======================================== */

  function loadCart() {

    try {

      const savedCart =
        localStorage.getItem(STORAGE_KEY);

      if (!savedCart) {

        cart = [];

        return;

      }

      const parsedCart =
        JSON.parse(savedCart);

      cart =
        Array.isArray(parsedCart)
          ? parsedCart
          : [];

    } catch {

      cart = [];

    }

  }


  function saveCart() {

    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(cart)
    );

  }


  function getCartQuantity(productId) {

    const item =
      cart.find(
        (product) =>
          Number(product.id) ===
          Number(productId)
      );

    return item
      ? item.quantity
      : 0;

  }


  function getTotalQuantity() {

    return cart.reduce(
      (total, item) =>
        total + Number(item.quantity || 0),
      0
    );

  }


  function updateHeaderCounter() {

    const headerCounter =
      document.querySelector("#cart-count");

    if (!headerCounter) return;

    const total =
      getTotalQuantity();

    headerCounter.textContent =
      String(total);

    headerCounter.classList.toggle(
      "visible",
      total > 0
    );

  }


      function updateProductQuantity(
      productId,
      productName,
      price,
      quantity
    ) {
      // Leer siempre la versión más reciente del carrito.
      try {
        const savedCart = localStorage.getItem(STORAGE_KEY);

        cart = savedCart ? JSON.parse(savedCart) : [];

        if (!Array.isArray(cart)) {
          cart = [];
        }
      } catch (error) {
        console.error("Error al leer el carrito:", error);
        return;
      }

      const existingItem = cart.find(
        (product) =>
          Number(product.id) === Number(productId)
      );

      if (quantity <= 0) {
        cart = cart.filter(
          (product) =>
            Number(product.id) !== Number(productId)
        );
      } else if (existingItem) {
        existingItem.quantity = quantity;
      } else {
        cart.push({
          id: Number(productId),
          name: productName,
          price: Number(price),
          quantity,
        });
      }

      saveCart();
      updateHeaderCounter();

      window.dispatchEvent(
        new StorageEvent("storage", {
          key: STORAGE_KEY,
          newValue: JSON.stringify(cart),
        })
      );
    }


      function formatPrice(price) {

        return new Intl.NumberFormat(
          "en-US",
          {
            style: "currency",
            currency: "USD",
          }
        ).format(Number(price));

      }


  /* ========================================
     PRODUCTOS
  ======================================== */

  function createOfferCard(product) {

    const originalPrice =
      Number(product.price);

    const offerPrice =
      Number(
        product.offerPrice ??
        product.price
      );

    const discount =
      originalPrice > 0
        ? Math.round(
            ((originalPrice - offerPrice) /
              originalPrice) *
              100
          )
        : 0;

    const category =
      product.category?.name ||
      "Artesanía";

    const image =
      product.image ||
      "https://images.unsplash.com/photo-1452860606245-08befc0ff44b?auto=format&fit=crop&w=900&q=80";


    const article =
      document.createElement("article");

    article.className =
      "offer-card";


    article.innerHTML = `

      <div class="offer-image">

        <img
          src="${image}"
          alt="${product.name}"
          loading="lazy"
        />

        <span class="discount-badge">
          -${discount}%
        </span>

        <button
          class="favorite"
          type="button"
          aria-label="Agregar ${product.name} a favoritos"
        >
          ♡
        </button>

      </div>


      <div class="offer-info">

        <span class="offer-category">
          ${category}
        </span>

        <h3>
          ${product.name}
        </h3>


        <div class="prices">

          <span class="old-price">
            ${formatPrice(originalPrice)}
          </span>

          <span class="offer-price">
            ${formatPrice(offerPrice)}
          </span>

        </div>


        <div class="cart-label">
          Agregar al carrito
        </div>


        <div
          class="quantity-control"
          data-product-id="${product.id}"
          data-product="${product.name}"
          data-price="${offerPrice}"
        >

          <button
            type="button"
            class="quantity-button decrease"
            aria-label="Quitar una unidad de ${product.name}"
          >
            −
          </button>

          <span
            class="quantity"
            aria-live="polite"
          >
            0
          </span>

          <button
            type="button"
            class="quantity-button increase"
            aria-label="Agregar una unidad de ${product.name}"
          >
            +
          </button>

        </div>

      </div>

    `;


    const control =
      article.querySelector(
        ".quantity-control"
      );

    const quantityElement =
      article.querySelector(
        ".quantity"
      );

    const decreaseButton =
      article.querySelector(
        ".decrease"
      );

    const increaseButton =
      article.querySelector(
        ".increase"
      );


    if (
      !control ||
      !quantityElement ||
      !decreaseButton ||
      !increaseButton
    ) {

      return article;

    }


    const productId =
      Number(
        control.dataset.productId
      );

    const productName =
      control.dataset.product || "";

    const price =
      Number(
        control.dataset.price || 0
      );


    let quantity =
      getCartQuantity(productId);


    quantityElement.textContent =
      String(quantity);


    decreaseButton.addEventListener(
      "click",
      () => {

        if (quantity > 0) {

          quantity--;

        }

        quantityElement.textContent =
          String(quantity);

        updateProductQuantity(
          productId,
          productName,
          price,
          quantity
        );

      }
    );


    increaseButton.addEventListener(
      "click",
      () => {

        quantity++;

        quantityElement.textContent =
          String(quantity);

        updateProductQuantity(
          productId,
          productName,
          price,
          quantity
        );

      }
    );


    return article;

  }


  async function loadOffers() {

    if (!track) return;


    try {

      const response =
        await fetch(
          "http://localhost:3000/api/products"
        );


      if (!response.ok) {

        throw new Error(
          "No se pudieron cargar los productos"
        );

      }


      const result =
        await response.json();


      const offers =
        result.success
          ? result.data.filter(
              (product) =>
                product.isOffer &&
                product.isActive
            )
          : [];


      track.innerHTML = "";


      offers.forEach(
        (product) => {

          track.appendChild(
            createOfferCard(product)
          );

        }
      );


      currentPosition = 0;

      updateCarousel();

    } catch (error) {

      console.error(
        "Error cargando ofertas:",
        error
      );

      track.innerHTML = `

        <p
          style="
            width:100%;
            padding:40px 0;
            color:#777168;
          "
        >
          No se pudieron cargar las ofertas.
        </p>

      `;

      updateCarousel();

    }

  }


  /* ========================================
     CARRUSEL
  ======================================== */

  function getVisibleOffers() {

    if (window.innerWidth <= 430) {

      return 1;

    }

    if (window.innerWidth <= 600) {

      return 2;

    }

    if (window.innerWidth <= 1000) {

      return 3;

    }

    return 4;

  }


  function getCardWidth() {

    if (!track) return 0;


    const firstCard =
      track.querySelector(
        ".offer-card"
      );


    if (!firstCard) {

      return 0;

    }


    const styles =
      window.getComputedStyle(track);


    const gap =
      parseFloat(styles.columnGap) ||
      parseFloat(styles.gap) ||
      0;


    return (
      firstCard.offsetWidth +
      gap
    );

  }


  function updateCarousel() {

    if (
      !track ||
      !prevButton ||
      !nextButton ||
      !counter ||
      !progress
    ) {

      return;

    }


    const visibleOffers =
      getVisibleOffers();


    const totalOffers =
      track.querySelectorAll(
        ".offer-card"
      ).length;


    const maxPosition =
      Math.max(
        0,
        totalOffers - visibleOffers
      );


    currentPosition =
      Math.min(
        currentPosition,
        maxPosition
      );


    const offset =
      currentPosition *
      getCardWidth();


    track.style.transform =
      `translateX(-${offset}px)`;


    prevButton.disabled =
      currentPosition === 0;


    nextButton.disabled =
      currentPosition >=
      maxPosition;


    const first =
      totalOffers === 0
        ? 0
        : currentPosition + 1;


    const last =
      totalOffers === 0
        ? 0
        : Math.min(
            currentPosition +
              visibleOffers,
            totalOffers
          );


    counter.textContent =
      `${String(first).padStart(2, "0")} — ${String(last).padStart(2, "0")}`;


    const percentage =
      maxPosition === 0
        ? totalOffers > 0
          ? 100
          : 0
        : ((currentPosition + 1) /
            (maxPosition + 1)) *
          100;


    progress.style.width =
      `${percentage}%`;

  }


  if (prevButton) {

    prevButton.addEventListener(
      "click",
      () => {

        if (
          currentPosition > 0
        ) {

          currentPosition--;

          updateCarousel();

        }

      }
    );

  }


  if (nextButton) {

    nextButton.addEventListener(
      "click",
      () => {

        const visibleOffers =
          getVisibleOffers();

        const totalOffers =
          track
            ? track.querySelectorAll(
                ".offer-card"
              ).length
            : 0;

        const maxPosition =
          Math.max(
            0,
            totalOffers -
              visibleOffers
          );


        if (
          currentPosition <
          maxPosition
        ) {

          currentPosition++;

          updateCarousel();

        }

      }
    );

  }


  window.addEventListener(
    "resize",
    updateCarousel
  );


  /* ========================================
     INICIALIZACIÓN
  ======================================== */

  loadCart();

  updateHeaderCounter();

  loadOffers();

</script>
