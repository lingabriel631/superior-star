---
// src/components/Offers.astro
---

<section class="offers" id="ofertas" aria-label="Ofertas Costa Azul">
  <div class="offers-container">

    <div class="section-header">
      <div>
        <span class="eyebrow">
          OFERTAS COSTA AZUL
        </span>

        <h2>
          Piezas con
          <em>descuento</em>
        </h2>
      </div>

      <p class="section-description">
        Descubre piezas artesanales seleccionadas
        con precios especiales por tiempo limitado.
      </p>
    </div>

    <div class="offers-wrapper">

      <button
        class="carousel-button carousel-prev"
        id="prev-offers"
        type="button"
        aria-label="Ofertas anteriores"
      >
        ←
      </button>

      <div class="offers-window">
        <div
          class="offers-track"
          id="offers-track"
        >
        </div>
      </div>

      <button
        class="carousel-button carousel-next"
        id="next-offers"
        type="button"
        aria-label="Siguientes ofertas"
      >
        →
      </button>

    </div>

    <div class="carousel-footer">

      <div class="progress">
        <div
          class="progress-bar"
          id="offers-progress"
        ></div>
      </div>

      <div
        class="offer-counter"
        id="offers-counter"
      >
        00 — 00
      </div>

    </div>

  </div>
</section>

<style is:global>

  /* ========================================
     SECCIÓN (ARENA LOS CÓBANOS)
  ======================================== */

  .offers {
    padding: 90px 0;
    background: #E7DCC8;
  }

  .offers-container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }

  /* ========================================
     ENCABEZADO
  ======================================== */

  .offers .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 48px;
  }

  .offers .eyebrow {
    display: block;
    margin-bottom: 10px;
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .offers .section-header h2 {
    margin: 0;
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .offers .section-header h2 em {
    color: #002B5C;
    font-style: italic;
    font-weight: 600;
  }

  .offers .section-description {
    max-width: 380px;
    margin: 0;
    color: #334155;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  /* ========================================
     CARRUSEL Y TARJETAS
  ======================================== */

  .offers-wrapper {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .offers-window {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }

  .offers-track {
    display: flex;
    gap: 22px;
    width: 100%;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .offer-card {
    flex: 0 0 calc((100% - 66px) / 4);
    width: calc((100% - 66px) / 4);
    min-width: 0;
    max-width: calc((100% - 66px) / 4);
    background: #FFFFFF;
    border: 1px solid rgba(0, 43, 92, 0.12);
    border-radius: 16px;
    padding: 14px;
    box-sizing: border-box;
    box-shadow: 0 6px 18px rgba(0, 43, 92, 0.06);
    transition: transform 0.25s ease;
  }

  .offer-card:hover {
    transform: translateY(-4px);
  }

  /* ========================================
     IMAGEN
  ======================================== */

  .offer-image {
    position: relative;
    width: 100%;
    aspect-ratio: 0.85;
    border-radius: 12px;
    overflow: hidden;
    background: #FAF8F5;
  }

  .offer-image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .offer-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .offer-card:hover .offer-image img {
    transform: scale(1.04);
  }

  /* ========================================
     DESCUENTO
  ======================================== */

  .discount-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 6px 12px;
    border-radius: 999px;
    background: #002B5C;
    color: #E7DCC8;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /* ========================================
     FAVORITOS
  ======================================== */

  .offers .favorite {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #002B5C;
    font-size: 1.25rem;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  .offers .favorite:hover {
    background: #002B5C;
    color: #FFFFFF;
    transform: scale(1.05);
  }

  /* ========================================
     INFORMACIÓN
  ======================================== */

  .offer-info {
    padding-top: 16px;
  }

  .offer-category {
    display: block;
    margin-bottom: 6px;
    color: #64748B;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .offer-info h3 {
    min-height: 42px;
    margin: 0;
  }

  .offers .product-title-link {
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .offers .product-title-link:hover {
    text-decoration: underline;
  }

  /* ========================================
     PRECIOS
  ======================================== */

  .prices {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .old-price {
    color: #94A3B8;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.85rem;
    text-decoration: line-through;
  }

  .offer-price {
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.08rem;
    font-weight: 800;
  }

  /* ========================================
     CARRITO (BOTÓN REDONDEADO)
  ======================================== */

  .offers .cart-label {
    margin-top: 14px;
    margin-bottom: 8px;
    color: #64748B;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .offers .quantity-control {
    width: 100%;
    min-height: 42px;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 42px;
    align-items: center;
    border-radius: 999px;
    border: 1.5px solid #002B5C;
    background: #002B5C;
    overflow: hidden;
  }

  .offers .quantity-button {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: #FFFFFF;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .offers .quantity-button:hover {
    background: #001d40;
  }

  .offers .quantity {
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid rgba(255, 255, 255, 0.25);
    border-right: 1px solid rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
  }

  /* ========================================
     FLECHAS
  ======================================== */

  .offers .carousel-button {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1.5px solid #002B5C;
    background: #FFFFFF;
    color: #002B5C;
    font-size: 1.15rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .offers .carousel-button:hover:not(:disabled) {
    background: #002B5C;
    color: #FFFFFF;
  }

  .offers .carousel-button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* ========================================
     PIE
  ======================================== */

  .offers .carousel-footer {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 35px;
  }

  .offers .progress {
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: rgba(0, 43, 92, 0.2);
    overflow: hidden;
  }

  .offers .progress-bar {
    width: 0%;
    height: 100%;
    background: #002B5C;
    transition: width 0.35s ease;
  }

  .offer-counter {
    min-width: 70px;
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: right;
  }

  /* ========================================
     RESPONSIVE
  ======================================== */

  @media (max-width: 1000px) {
    .offer-card {
      flex: 0 0 calc((100% - 44px) / 3);
      width: calc((100% - 44px) / 3);
      max-width: calc((100% - 44px) / 3);
    }
  }

  @media (max-width: 600px) {
    .offers {
      padding: 70px 0;
    }

    .offers .section-header {
      display: block;
      margin-bottom: 32px;
    }

    .offers .section-description {
      margin-top: 14px;
    }

    .offers-wrapper {
      gap: 10px;
    }

    .offer-card {
      flex: 0 0 calc((100% - 22px) / 2);
      width: calc((100% - 22px) / 2);
      max-width: calc((100% - 22px) / 2);
    }

    .offers .carousel-button {
      flex: 0 0 36px;
      width: 36px;
      height: 36px;
    }
  }

  @media (max-width: 430px) {
    .offer-card {
      flex: 0 0 100%;
      width: 100%;
      max-width: 100%;
    }
  }

</style>

<script>

  const STORAGE_KEY = "tekiti-cart";

  const track =
    document.querySelector("#offers-track");

  const prevButton =
    document.querySelector("#prev-offers");

  const nextButton =
    document.querySelector("#next-offers");

  const counter =
    document.querySelector("#offers-counter");

  const progress =
    document.querySelector("#offers-progress");

  let cart = [];
  let currentPosition = 0;

  function loadCart() {
    try {
      const savedCart = localStorage.getItem(STORAGE_KEY);
      const parsedCart = savedCart ? JSON.parse(savedCart) : [];
      cart = Array.isArray(parsedCart) ? parsedCart : [];
    } catch {
      cart = [];
    }
  }

  function saveCart() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
  }

  function getCartQuantity(productId) {
    const item = cart.find(
      (product) => Number(product.id) === Number(productId)
    );
    return item ? item.quantity : 0;
  }

  function getTotalQuantity() {
    return cart.reduce(
      (total, item) => total + Number(item.quantity || 0),
      0
    );
  }

  function updateHeaderCounter() {
    const headerCounter = document.querySelector("#cart-count");
    if (!headerCounter) return;

    const total = getTotalQuantity();
    headerCounter.textContent = String(total);
    headerCounter.classList.toggle("visible", total > 0);
  }

  function updateProductQuantity(
    productId,
    productName,
    price,
    quantity
  ) {
    loadCart();

    const existingItem = cart.find(
      (product) => Number(product.id) === Number(productId)
    );

    if (quantity <= 0) {
      cart = cart.filter(
        (product) => Number(product.id) !== Number(productId)
      );
    } else if (existingItem) {
      existingItem.quantity = quantity;
    } else {
      cart.push({
        id: Number(productId),
        name: productName,
        price: Number(price),
        quantity,
      });
    }

    saveCart();
    updateHeaderCounter();

    window.dispatchEvent(
      new StorageEvent("storage", {
        key: STORAGE_KEY,
        newValue: JSON.stringify(cart),
      })
    );
    window.dispatchEvent(new CustomEvent("tekiti-cart-updated"));
  }

  function formatPrice(price) {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: "USD",
    }).format(Number(price));
  }

  function createOfferCard(product) {
    const originalPrice = Number(product.price);
    const offerPrice = Number(product.offerPrice ?? product.price);

    const discount =
      originalPrice > 0
        ? Math.round(((originalPrice - offerPrice) / originalPrice) * 100)
        : 0;

    const category = product.category?.name || "Artesanía";
    const image =
      product.image ||
      "https://images.unsplash.com/photo-1452860606245-08befc0ff44b?auto=format&fit=crop&w=900&q=80";

    const article = document.createElement("article");
    article.className = "offer-card";

    article.innerHTML = `
      <div class="offer-image">
        <a href="/products/${product.slug}">
          <img src="${image}" alt="${product.name}" loading="lazy"/>
        </a>
        <span class="discount-badge">-${discount}%</span>
        <button class="favorite" type="button" aria-label="Agregar ${product.name} a favoritos">♡</button>
      </div>
      <div class="offer-info">
        <span class="offer-category">${category}</span>
        <h3>
          <a href="/products/${product.slug}" class="product-title-link">${product.name}</a>
        </h3>
        <div class="prices">
          <span class="old-price">${formatPrice(originalPrice)}</span>
          <span class="offer-price">${formatPrice(offerPrice)}</span>
        </div>
        <div class="cart-label">Agregar al carrito</div>
        <div
          class="quantity-control"
          data-product-id="${product.id}"
          data-product="${product.name}"
          data-price="${offerPrice}"
        >
          <button type="button" class="quantity-button decrease" aria-label="Quitar una unidad">−</button>
          <span class="quantity" aria-live="polite">0</span>
          <button type="button" class="quantity-button increase" aria-label="Agregar una unidad">+</button>
        </div>
      </div>
    `;

    const control = article.querySelector(".quantity-control");
    const quantityElement = article.querySelector(".quantity");
    const decreaseButton = article.querySelector(".decrease");
    const increaseButton = article.querySelector(".increase");

    if (!control || !quantityElement || !decreaseButton || !increaseButton) {
      return article;
    }

    const productId = Number(control.dataset.productId);
    const productName = control.dataset.product || "";
    const price = Number(control.dataset.price || 0);

    let quantity = getCartQuantity(productId);
    quantityElement.textContent = String(quantity);

    decreaseButton.addEventListener("click", () => {
      const current = getCartQuantity(productId);
      const newQty = Math.max(0, current - 1);
      quantityElement.textContent = String(newQty);
      updateProductQuantity(productId, productName, price, newQty);
    });

    increaseButton.addEventListener("click", () => {
      const current = getCartQuantity(productId);
      const newQty = current + 1;
      quantityElement.textContent = String(newQty);
      updateProductQuantity(productId, productName, price, newQty);
    });

    return article;
  }

  async function loadOffers() {
    if (!track) return;

    try {
      const API_URL = import.meta.env.PUBLIC_API_URL || "https://superior-star.onrender.com";
      const response = await fetch(`${API_URL}/api/products`);
      if (!response.ok) throw new Error("No se pudieron cargar los productos");

      const result = await response.json();
      const offers = result.success
        ? result.data.filter((product) => product.isOffer && product.isActive)
        : [];

      track.innerHTML = "";
      offers.forEach((product) => {
        track.appendChild(createOfferCard(product));
      });

      currentPosition = 0;
      updateCarousel();
    } catch (error) {
      console.error("Error cargando ofertas:", error);
      track.innerHTML = `<p style="width:100%;padding:40px 0;color:#334155;">No se pudieron cargar las ofertas.</p>`;
      updateCarousel();
    }
  }

  window.addEventListener("tekiti-cart-updated", () => {
    loadCart();
    if (!track) return;

    const controls = track.querySelectorAll(".quantity-control");
    controls.forEach((control) => {
      const productId = Number(control.dataset.productId || 0);
      const quantityElement = control.querySelector(".quantity");
      if (quantityElement) {
        quantityElement.textContent = String(getCartQuantity(productId));
      }
    });

    updateHeaderCounter();
  });

  window.addEventListener("storage", () => {
    if (STORAGE_KEY) {
      window.dispatchEvent(new CustomEvent("tekiti-cart-updated"));
    }
  });

  function getVisibleOffers() {
    if (window.innerWidth <= 430) return 1;
    if (window.innerWidth <= 600) return 2;
    if (window.innerWidth <= 1000) return 3;
    return 4;
  }

  function getCardWidth() {
    if (!track) return 0;
    const firstCard = track.querySelector(".offer-card");
    if (!firstCard) return 0;

    const styles = window.getComputedStyle(track);
    const gap = parseFloat(styles.columnGap) || parseFloat(styles.gap) || 0;
    return firstCard.offsetWidth + gap;
  }

  function updateCarousel() {
    if (!track || !prevButton || !nextButton || !counter || !progress) return;

    const visibleOffers = getVisibleOffers();
    const totalOffers = track.querySelectorAll(".offer-card").length;
    const maxPosition = Math.max(0, totalOffers - visibleOffers);

    currentPosition = Math.min(currentPosition, maxPosition);
    const offset = currentPosition * getCardWidth();

    track.style.transform = `translateX(-${offset}px)`;
    prevButton.disabled = currentPosition === 0;
    nextButton.disabled = currentPosition >= maxPosition;

    const first = totalOffers === 0 ? 0 : currentPosition + 1;
    const last = totalOffers === 0 ? 0 : Math.min(currentPosition + visibleOffers, totalOffers);

    counter.textContent = `${String(first).padStart(2, "0")} — ${String(last).padStart(2, "0")}`;

    const percentage =
      maxPosition === 0
        ? totalOffers > 0 ? 100 : 0
        : ((currentPosition + 1) / (maxPosition + 1)) * 100;

    progress.style.width = `${percentage}%`;
  }

  if (prevButton) {
    prevButton.addEventListener("click", () => {
      if (currentPosition > 0) {
        currentPosition--;
        updateCarousel();
      }
    });
  }

  if (nextButton) {
    nextButton.addEventListener("click", () => {
      const visibleOffers = getVisibleOffers();
      const totalOffers = track ? track.querySelectorAll(".offer-card").length : 0;
      const maxPosition = Math.max(0, totalOffers - visibleOffers);

      if (currentPosition < maxPosition) {
        currentPosition++;
        updateCarousel();
      }
    });
  }

  window.addEventListener("resize", updateCarousel);

  loadCart();
  updateHeaderCounter();
  loadOffers();

</script>