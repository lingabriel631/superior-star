---
// src/components/Footer.astro
---

<footer class="footer" id="footer" aria-label="Pie de página de Costa Azul">
  <div class="container footer-grid">

    <div class="footer-brand">
      <span class="footer-eyebrow">LOS CÓBANOS • EL SALVADOR</span>
      <h3>COSTA AZUL</h3>
      <p>
        Artesanías, textiles y piezas creadas con la calidez y el espíritu de la costa salvadoreña.
      </p>
    </div>

    <div class="footer-nav">
      <h4>Navegación</h4>
      <a href="#inicio">Inicio</a>
      <a href="#novedades">Novedades</a>
      <a href="#ofertas">Ofertas</a>
      <a href="#categorias">Categorías</a>
    </div>

    <div class="footer-nav">
      <h4>Tienda y Redes</h4>
      <a href="/cuenta">Mi cuenta</a>
      <a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="https://facebook.com" target="_blank" rel="noopener noreferrer">Facebook</a>
    </div>

  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-content">
      <span>Costa Azul &copy; {new Date().getFullYear()} — Todos los derechos reservados</span>
      <span>Hecho en El Salvador</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #002B5C;
    color: #E7DCC8;
    padding-top: 68px;
    border-top: 2px solid rgba(231, 220, 200, 0.25);
  }

  .container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 52px;
  }

  .footer-eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    color: #E7DCC8;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    opacity: 0.85;
  }

  .footer-brand h3 {
    margin: 0 0 12px;
    color: #FFFFFF;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .footer-brand p {
    margin: 0;
    max-width: 380px;
    color: rgba(231, 220, 200, 0.88);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-nav h4 {
    margin: 0 0 6px;
    color: #FFFFFF;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .footer-nav a {
    width: fit-content;
    color: #E7DCC8;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .footer-nav a:hover {
    color: #FFFFFF;
    transform: translateX(3px);
  }

  .footer-bottom {
    border-top: 1px solid rgba(231, 220, 200, 0.18);
    padding: 20px 0;
  }

  .footer-bottom-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: rgba(231, 220, 200, 0.78);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.82rem;
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-bottom: 40px;
    }

    .footer-bottom-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>