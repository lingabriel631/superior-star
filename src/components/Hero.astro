---
// src/components/Hero.astro
const slides = [
  {
    number: "01",
    category: "ESENCIA COSTERA",
    title: "Lo nuevo de Costa Azul",
    description: "Descubre piezas artesanales inspiradas en las olas y la arena de Los Cóbanos.",
    button: "Explorar colección",
    link: "#productos",
    image: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=85",
  },
  {
    number: "02",
    category: "COLECCIONES",
    title: "Historias del Pacífico",
    description: "Creaciones elaboradas por manos salvadoreñas con texturas y tonos del mar.",
    button: "Ver colección",
    link: "#productos",
    image: "https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=2000&q=85",
  },
];
---

<section class="hero" aria-label="Destacados de Costa Azul">
  <div class="slides">
    {slides.map((slide, index) => (
      <article class:list={["slide", { active: index === 0 }]} data-slide={index}>
        <img src={slide.image} alt={slide.title} class="slide-image" />
        <div class="overlay"></div>
        <div class="hero-content">
          <span class="category">{slide.category}</span>
          <h1>{slide.title}</h1>
          <p>{slide.description}</p>
          <a href={slide.link} class="hero-button">
            {slide.button}
            <span>→</span>
          </a>
        </div>
        <div class="slide-number">
          <span>{slide.number}</span>
          <span class="separator">/</span>
          <span>02</span>
        </div>
      </article>
    ))}
  </div>

  <button class="arrow arrow-left" aria-label="Anterior" id="prevSlide">←</button>
  <button class="arrow arrow-right" aria-label="Siguiente" id="nextSlide">→</button>

  <div class="indicators">
    {slides.map((_, index) => (
      <button class:list={["indicator", { active: index === 0 }]} data-indicator={index} aria-label={`Ir al slide ${index + 1}`}></button>
    ))}
  </div>
</section>

<script>
  const slides = document.querySelectorAll<HTMLElement>(".slide");
  const indicators = document.querySelectorAll<HTMLButtonElement>(".indicator");
  const prevButton = document.querySelector<HTMLButtonElement>("#prevSlide");
  const nextButton = document.querySelector<HTMLButtonElement>("#nextSlide");
  const hero = document.querySelector<HTMLElement>(".hero");

  let currentSlide = 0;
  let autoplay: number;

  function showSlide(index: number) {
    slides.forEach((slide, i) => slide.classList.toggle("active", i === index));
    indicators.forEach((indicator, i) => indicator.classList.toggle("active", i === index));
    currentSlide = index;
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % slides.length);
  }

  function previousSlide() {
    showSlide((currentSlide - 1 + slides.length) % slides.length);
  }

  function startAutoplay() {
    autoplay = window.setInterval(nextSlide, 6000);
  }

  function stopAutoplay() {
    window.clearInterval(autoplay);
  }

  nextButton?.addEventListener("click", () => { nextSlide(); stopAutoplay(); startAutoplay(); });
  prevButton?.addEventListener("click", () => { previousSlide(); stopAutoplay(); startAutoplay(); });
  hero?.addEventListener("mouseenter", stopAutoplay);
  hero?.addEventListener("mouseleave", startAutoplay);
  startAutoplay();
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: min(720px, calc(100vh - 82px));
    min-height: 580px;
    overflow: hidden;
    background: #002B5C;
  }

  .slides { position: relative; width: 100%; height: 100%; }
  .slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 0.8s ease, visibility 0.8s ease; }
  .slide.active { opacity: 1; visibility: visible; }
  .slide-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.04); transition: transform 6s ease; }
  .slide.active .slide-image { transform: scale(1); }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 43, 92, 0.85) 0%, rgba(0, 43, 92, 0.5) 45%, rgba(0, 43, 92, 0.2) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(1200px, 92%);
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 40px;
    padding-left: 50px;
  }

  .category {
    display: block;
    margin-bottom: 22px;
    color: #E7DCC8; /* Arena Los Cóbanos */
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 720px;
    margin: 0;
    color: #fff;
    font-family: Georgia, serif;
    font-size: clamp(3rem, 6vw, 5.8rem);
    font-weight: 400;
    line-height: 0.98;
  }

  .hero p {
    max-width: 500px;
    margin: 28px 0 36px;
    color: rgba(231, 220, 200, 0.9);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .hero-button {
    width: fit-content;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 15px 22px;
    color: #002B5C;
    background: #E7DCC8;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    transition: background 0.25s ease, transform 0.25s ease;
    border-radius: 4px;
  }

  .hero-button:hover {
    background: #fff;
    transform: translateY(-2px);
  }

  .slide-number {
    position: absolute;
    z-index: 3;
    right: 6%;
    bottom: 55px;
    display: flex;
    gap: 8px;
    color: #fff;
    font-size: 0.8rem;
  }

  .arrow {
    position: absolute;
    z-index: 5;
    top: 50%;
    width: 52px;
    height: 52px;
    border: 1px solid rgba(231, 220, 200, 0.45);
    color: #fff;
    background: rgba(0, 43, 92, 0.3);
    font-size: 1.2rem;
    cursor: pointer;
    transform: translateY(-50%);
    transition: background 0.25s ease;
  }

  .arrow:hover { background: rgba(0, 43, 92, 0.7); }
  .arrow-left { left: 30px; }
  .arrow-right { right: 30px; }

  .indicators {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: 35px;
    display: flex;
    gap: 8px;
    transform: translateX(-50%);
  }

  .indicator {
    width: 32px;
    height: 2px;
    padding: 0;
    border: 0;
    background: rgba(231, 220, 200, 0.4);
    cursor: pointer;
  }

  .indicator.active {
    width: 55px;
    background: #E7DCC8;
  }
</style>