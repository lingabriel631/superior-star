---
const slides = [
  {
    number: "01",
    category: "LOS CÓBANOS • EL SALVADOR",
    title: "Descubre Nuestra Colección",
    description: "Artesanías, textiles tejidos a mano y piezas únicas inspiradas en las aguas y arenas de la costa salvadoreña.",
    button: "Descubre Nuestra Colección",
    link: "#novedades",
    image: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=85",
  },
  {
    number: "02",
    category: "HECHO A MANO",
    title: "La Magia de Nuestra Costa",
    description: "Cada pieza refleja la calidez del Pacífico y el talento de artesanos locales.",
    button: "Explorar Piezas",
    link: "#novedades",
    image: "https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=2000&q=85",
  },
];
---

<section class="hero" id="inicio" aria-label="Destacados de Costa Azul">
  <div class="slides">
    {slides.map((slide, index) => (
      <article class:list={["slide", { active: index === 0 }]} data-slide={index}>
        <img src={slide.image} alt={slide.title} class="slide-image" />
        <div class="overlay"></div>
        <div class="hero-content">
          <span class="category">{slide.category}</span>
          <h1>{slide.title}</h1>
          <p>{slide.description}</p>
          <a href={slide.link} class="hero-button">
            {slide.button}
          </a>
        </div>
      </article>
    ))}
  </div>

  <button class="arrow arrow-left" aria-label="Anterior" id="prevSlide">←</button>
  <button class="arrow arrow-right" aria-label="Siguiente" id="nextSlide">→</button>

  <div class="indicators">
    {slides.map((_, index) => (
      <button class:list={["indicator", { active: index === 0 }]} data-indicator={index} aria-label={`Slide ${index + 1}`}></button>
    ))}
  </div>
</section>

<script>
  const slides = document.querySelectorAll<HTMLElement>(".slide");
  const indicators = document.querySelectorAll<HTMLButtonElement>(".indicator");
  const prevButton = document.querySelector<HTMLButtonElement>("#prevSlide");
  const nextButton = document.querySelector<HTMLButtonElement>("#nextSlide");

  let currentSlide = 0;

  function showSlide(index: number) {
    slides.forEach((slide, i) => slide.classList.toggle("active", i === index));
    indicators.forEach((indicator, i) => indicator.classList.toggle("active", i === index));
    currentSlide = index;
  }

  nextButton?.addEventListener("click", () => showSlide((currentSlide + 1) % slides.length));
  prevButton?.addEventListener("click", () => showSlide((currentSlide - 1 + slides.length) % slides.length));
  indicators.forEach((ind, i) => ind.addEventListener("click", () => showSlide(i)));
  window.setInterval(() => showSlide((currentSlide + 1) % slides.length), 6000);
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: min(600px, calc(100vh - 80px));
    min-height: 480px;
    overflow: hidden;
    background: #002B5C;
  }

  .slides, .slide { position: absolute; inset: 0; width: 100%; height: 100%; }
  .slide { opacity: 0; visibility: hidden; transition: opacity 0.7s ease; }
  .slide.active { opacity: 1; visibility: visible; }
  .slide-image { width: 100%; height: 100%; object-fit: cover; }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 43, 92, 0.35), rgba(0, 43, 92, 0.65));
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(900px, 90%);
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .category {
    display: inline-block;
    padding: 6px 16px;
    margin-bottom: 18px;
    border-radius: 999px;
    background: rgba(231, 220, 200, 0.92);
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .hero h1 {
    margin: 0;
    color: #FFFFFF;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.1;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }

  .hero p {
    max-width: 580px;
    margin: 18px 0 30px;
    color: #FAF8F5;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* BOTÓN ESTILO COSTA AZUL */
  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 32px;
    border-radius: 10px;
    background: #002B5C;
    border: 2px solid #E7DCC8;
    color: #FFFFFF;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(0, 43, 92, 0.3);
    transition: all 0.25s ease;
  }

  .hero-button:hover {
    background: #E7DCC8;
    color: #002B5C;
    transform: translateY(-2px);
  }

  .arrow {
    position: absolute;
    z-index: 5;
    top: 50%;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #FFFFFF;
    background: rgba(0, 43, 92, 0.45);
    font-size: 1.1rem;
    cursor: pointer;
    transform: translateY(-50%);
    transition: background 0.2s ease;
  }

  .arrow:hover { background: #002B5C; }
  .arrow-left { left: 24px; }
  .arrow-right { right: 24px; }

  .indicators {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: 24px;
    display: flex;
    gap: 8px;
    transform: translateX(-50%);
  }

  .indicator {
    width: 28px;
    height: 4px;
    border-radius: 999px;
    border: 0;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
  }

  .indicator.active {
    width: 44px;
    background: #E7DCC8;
  }
</style>