---
// src/components/Suppliers.astro

const suppliers = [
  {
    id: 1,
    slug: "cooperativa-manos-de-suchitoto",
    name: "Cooperativa Manos de Suchitoto",
    location: "Suchitoto",
    bio: "Especialistas en textiles tradicionales y tejido en telar de pedal, transmitiendo el arte de generación en generación.",
    image: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=300&q=80"
  },
  {
    id: 2,
    slug: "talleres-artesanales-la-palma",
    name: "Talleres Artesanales La Palma",
    location: "La Palma, Chalatenango",
    bio: "Familia dedicada al trabajo en madera de pino y coloridas pinturas inspiradas en el estilo del maestro Fernando Llort.",
    image: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=300&q=80"
  },
  {
    id: 3,
    slug: "artesanias-de-barro-ilobasco",
    name: "Artesanías de Barro Ilobasco",
    location: "Ilobasco",
    bio: "Renombrados creadores de miniatura en barro y alfarería tradicional con acabados finamente detallados a mano.",
    image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80"
  }
];
---

<section class="suppliers" id="proveedores" aria-label="Proveedores de Costa Azul">
  <div class="container">

    <!-- ENCABEZADO -->
    <div class="section-header">
      <div>
        <span class="eyebrow">MANOS ARTESANAS • COSTA AZUL</span>
        <h2>
          Conoce a nuestros
          <em>proveedores</em>
        </h2>
      </div>

      <p class="section-description">
        Detrás de cada diseño hay historias de tradición, talento y dedicación familiar provenientes de diferentes rincones.
      </p>
    </div>

    <!-- CONTENEDOR DE PROVEEDORES -->
    <div class="suppliers-grid">
      {suppliers.map((supplier) => (
        <a href={`/proveedores/${supplier.slug}`} class="supplier-card">
          <div class="supplier-avatar">
            <img src={supplier.image} alt={supplier.name} loading="lazy" />
          </div>
          <h3 class="supplier-name">{supplier.name}</h3>
          <span class="supplier-location">📍 {supplier.location}</span>
          <p class="supplier-bio">{supplier.bio}</p>
          <span class="supplier-cta">Ver taller</span>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .suppliers {
    padding: 90px 0;
    background: #E7DCC8;
    border-top: 1px solid rgba(0, 43, 92, 0.1);
  }

  .container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 48px;
  }

  .eyebrow {
    display: block;
    margin-bottom: 10px;
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .section-header h2 {
    margin: 0;
    color: #002B5C;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .section-header h2 em {
    color: #002B5C;
    font-style: italic;
    font-weight: 600;
  }

  .section-description {
    max-width: 380px;
    margin: 0;
    color: #334155;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .suppliers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .supplier-card {
    background: #FFFFFF;
    border: 1px solid rgba(0, 43, 92, 0.12);
    border-radius: 16px;
    padding: 30px 24px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 6px 18px rgba(0, 43, 92, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .supplier-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 43, 92, 0.11);
  }

  .supplier-avatar {
    width: 92px;
    height: 92px;
    margin: 0 auto 18px auto;
    border-radius: 50%;
    overflow: hidden;
    background: #FAF8F5;
    border: 3px solid #002B5C;
  }

  .supplier-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .supplier-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: #002B5C;
    margin: 0 0 6px 0;
  }

  .supplier-location {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }

  .supplier-bio {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.92rem;
    color: #475569;
    line-height: 1.6;
    margin: 0 0 20px 0;
  }

  .supplier-cta {
    margin-top: auto;
    padding: 8px 20px;
    border-radius: 999px;
    background: #002B5C;
    color: #FFFFFF;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .supplier-card:hover .supplier-cta {
    background: #001d40;
  }

  @media (max-width: 768px) {
    .suppliers {
      padding: 70px 0;
    }

    .section-header {
      display: block;
      margin-bottom: 32px;
    }

    .section-description {
      margin-top: 16px;
    }
  }
</style>